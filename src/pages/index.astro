---
// Root route for the Astro skeleton: Language Gateway
// Source: Notion “Root — Language Gateway — index.html” (ported to Astro)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Midori Beauty — Choose language</title>
    <meta
      name="description"
      content="Midori Beauty is a private lash, nail and foot care home studio in Tikkurila, Vantaa."
    />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <style>
      :root{
        --forest:#364731; --deep:#263322; --ivory:#F2EAD3; --sage:#909580;
        --sage-light:#C7C9B2; --muted:#ADAE99;
      }
      *{box-sizing:border-box}
      html{height:100%;scroll-behavior:smooth}
      body{margin:0;min-height:100%;background:var(--forest);color:var(--ivory);font-family:"Avenir Next","Segoe UI",system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
      a{color:inherit;text-decoration:none}
      .page{position:relative;min-height:100vh;min-height:100svh;min-height:100dvh;display:grid;place-items:center;padding:32px 22px calc(86px + env(safe-area-inset-bottom));isolation:isolate;overflow:hidden}
      .page::before{content:"";position:absolute;inset:0;z-index:-3;background:radial-gradient(circle at 50% 42%,rgba(242,234,211,.10),transparent 28%),var(--forest)}
      .page::after{content:"";position:absolute;inset:0;z-index:-2;opacity:.72;background-image:linear-gradient(rgba(242,234,211,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(242,234,211,.016) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(circle at center,black,transparent 78%)}
      .orb{position:absolute;width:min(56vw,680px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(242,234,211,.11),rgba(199,201,178,.05) 34%,transparent 68%);filter:blur(2px);z-index:-1;animation:breathe 8s ease-in-out infinite}
      .leaf{position:absolute;width:280px;height:280px;right:-80px;top:18%;z-index:-1;opacity:.16;transform:rotate(-18deg);border:1px solid rgba(242,234,211,.34);border-radius:62% 38% 62% 38%;filter:blur(.1px)}
      .leaf::after{content:"";position:absolute;width:160px;height:1px;background:rgba(242,234,211,.45);left:58px;top:140px;transform:rotate(-34deg);transform-origin:left center}
      .wrap{width:min(100%,560px);text-align:center;display:grid;justify-items:center;transform:translateY(-18px);animation:enter .9s cubic-bezier(.2,.7,.2,1) both}
      .icon{width:clamp(118px,20vw,174px);height:clamp(118px,20vw,174px);object-fit:contain;margin:0 auto 12px;filter:drop-shadow(0 18px 45px rgba(20,28,18,.18))}
      .location{font-size:.72rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(242,234,211,.58);margin-bottom:20px}
      h1{margin:0;font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;font-size:clamp(2.4rem,7vw,4.7rem);font-weight:500;line-height:.98;letter-spacing:-.035em;color:var(--ivory)}
      .subtitle{margin:24px 0 0;color:rgba(242,234,211,.86);line-height:1.55;font-size:1rem}
      .subtitle em{display:block;margin-top:3px;color:rgba(242,234,211,.66);font-size:.94rem}
      .actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:34px}
      .btn{min-width:170px;min-height:48px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:0 20px;font-size:.94rem;font-weight:600;transition:transform .2s ease,background .2s ease,border-color .2s ease,color .2s ease}
      .btn.primary{background:var(--ivory);color:var(--forest)}
      .btn.secondary{border:1px solid rgba(242,234,211,.32);color:var(--ivory);background:rgba(242,234,211,.05)}
      .btn:hover{transform:translateY(-2px)}
      .hint{margin-top:18px;color:rgba(242,234,211,.42);font-size:.78rem}
      footer{position:absolute;left:0;right:0;bottom:0;padding:0 20px calc(22px + env(safe-area-inset-bottom));text-align:center;color:rgba(242,234,211,.48);font-size:.78rem;line-height:1.7}
      footer a{transition:color .2s ease} footer a:hover{color:var(--ivory)}
      @keyframes enter{from{opacity:0;transform:translateY(12px) scale(.985)}to{opacity:1;transform:translateY(-18px) scale(1)}}
      @keyframes breathe{0%,100%{transform:scale(.98);opacity:.8}50%{transform:scale(1.04);opacity:1}}
      @media (max-width:520px){.page{padding:24px 22px calc(92px + env(safe-area-inset-bottom));overflow:visible}.icon{width:clamp(112px,30vw,132px);height:clamp(112px,30vw,132px);margin-bottom:12px}h1{font-size:clamp(2.25rem,13vw,3.4rem)}.actions{width:100%;gap:10px}.btn{width:min(100%,260px)}.subtitle{font-size:.95rem;margin-top:18px}.leaf{display:none}}
      @media (max-height:620px){.page{display:flex;flex-direction:column;justify-content:center;align-items:center;padding:18px 22px calc(18px + env(safe-area-inset-bottom));overflow-y:auto}.wrap{transform:none}.icon{width:86px;height:86px;margin-bottom:8px}h1{font-size:clamp(2rem,7vw,3rem)}.subtitle{margin-top:14px}.actions{margin-top:20px}footer{position:static;margin-top:26px;padding-bottom:12px}}
    </style>
  </head>
  <body>
    <main class="page" aria-label="Choose language">
      <div class="orb" aria-hidden="true"></div>
      <div class="leaf" aria-hidden="true"></div>
      <section class="wrap">
        <img class="icon" src="/assets/icon-transparent.png" alt="Midori Beauty icon" />
        <div class="location">Tikkurila · Vantaa</div>
        <h1>Midori Beauty</h1>
        <p class="subtitle">
          Asian Minimal Beauty
          <em>A private lash, nail &amp; foot care home studio</em>
        </p>
        <div class="actions" aria-label="Language options">
          <a class="btn primary" href="/fi/" data-lang="fi">Jatka suomeksi</a>
          <a class="btn secondary" href="/en/" data-lang="en">Continue in English</a>
        </div>
        <p class="hint" id="redirectHint">Opening Finnish version shortly…</p>
      </section>
      <footer>
        <a href="https://www.midoribeauty.fi">www.midoribeauty.fi</a><br />
        © <span id="year"></span> Midori Beauty
      </footer>
    </main>
    <script>
      const YEAR = document.getElementById('year');
      if (YEAR) YEAR.textContent = new Date().getFullYear();

      const params = new URLSearchParams(window.location.search);
      const resetLanguage = params.has('choose');
      const savedLanguage = resetLanguage ? null : localStorage.getItem('midori-language');
      const routes = { fi: '/fi/', en: '/en/' };

      document.querySelectorAll('[data-lang]').forEach((link) => {
        link.addEventListener('click', () => {
          localStorage.setItem('midori-language', link.dataset.lang);
        });
      });

      if (savedLanguage && routes[savedLanguage]) {
        const hint = document.getElementById('redirectHint');
        if (hint) hint.textContent = savedLanguage === 'fi' ? 'Jatketaan suomenkieliselle sivulle…' : 'Continuing to English version…';
        window.setTimeout(() => { window.location.href = routes[savedLanguage]; }, 900);
      } else {
        window.setTimeout(() => { window.location.href = routes.fi; }, 7000);
      }
    </script>
  </body>
</html>
