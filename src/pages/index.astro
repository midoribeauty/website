    <div class="status" aria-label="Opening status"><div class="opening">Opening Soon</div><div class="substatus">Booking will open soon</div></div>
  </section>
  <footer class="footer"><a href="https://www.midoribeauty.fi" aria-label="Visit Midori Beauty website">www.midoribeauty.fi</a><span>© 2026 Midori Beauty</span></footer>
</main>
</body>
</html>
