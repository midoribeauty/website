<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Midori Beauty · Coming Soon</title>
<meta name="description" content="Midori Beauty — Asian Minimal Beauty in Tikkurila, Vantaa. Opening soon." />
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<style>
:root{--forest:#364731;--deep:#263322;--ivory:#F2EAD3;--sage:#909580;--sageLight:#C7C9B2}*{box-sizing:border-box}html,body{height:100%;margin:0}body{font-family:"Avenir Next","Segoe UI",system-ui,-apple-system,Roboto,sans-serif;background:var(--forest);color:var(--ivory);overflow-x:hidden;overflow-y:auto;-webkit-font-smoothing:antialiased}.page{min-height:100vh;min-height:100svh;min-height:100dvh;display:grid;place-items:center;position:relative;padding:32px;isolation:isolate;overflow:hidden}.page::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 42%,rgba(242,234,211,.10),transparent 28%),var(--forest);z-index:-3}.page::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(242,234,211,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(242,234,211,.016) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(circle at center,black,transparent 78%);opacity:.72;z-index:-2}.orb{position:absolute;width:min(56vw,680px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(242,234,211,.11),rgba(199,201,178,.05) 34%,transparent 68%);filter:blur(2px);z-index:-1;animation:breathe 8s ease-in-out infinite}.card{width:min(100%,640px);text-align:center;display:flex;flex-direction:column;align-items:center;animation:enter .9s cubic-bezier(.2,.7,.2,1) both;transform:translateY(-18px)}.logo-wrap{position:relative;width:clamp(118px,20vw,174px);height:clamp(118px,20vw,174px);display:grid;place-items:center;margin-bottom:12px}.logo-wrap::before{content:"";position:absolute;inset:-34px;border-radius:50%;background:radial-gradient(circle,rgba(242,234,211,.08),transparent 64%);z-index:-1}.logo{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 18px 45px rgba(20,28,18,.18))}.kicker{font-size:.76rem;letter-spacing:.32em;text-transform:uppercase;color:var(--sageLight);margin:0 0 16px}.title{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;font-weight:500;letter-spacing:-.035em;font-size:clamp(2.4rem,7vw,4.7rem);line-height:.98;margin:0 0 24px}.lead{display:grid;gap:6px;font-size:clamp(1rem,2.2vw,1.1rem);line-height:1.45;font-weight:300;color:rgba(242,234,211,.92);max-width:34rem;margin:0 auto 34px}.lead em{font-size:.94em;color:rgba(242,234,211,.76);font-style:italic}.status{margin-top:2px;display:grid;gap:12px;justify-items:center}.opening{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;font-size:clamp(1.45rem,3.5vw,2.05rem);letter-spacing:.035em;font-weight:500;color:var(--ivory);padding:10px 28px 12px;border:1px solid rgba(242,234,211,.24);border-radius:16px;background:rgba(242,234,211,.055);box-shadow:inset 0 1px 0 rgba(242,234,211,.08)}.substatus{font-size:.94rem;color:rgba(242,234,211,.56);font-style:italic}.footer{position:absolute;left:50%;bottom:calc(24px + env(safe-area-inset-bottom));transform:translateX(-50%);display:grid;gap:4px;justify-items:center;color:rgba(242,234,211,.43);font-size:.72rem;line-height:1.35;letter-spacing:.02em}.footer a{color:rgba(242,234,211,.48);text-decoration:none;transition:color .2s ease}.footer a:hover{color:rgba(242,234,211,.78)}.footer a:focus-visible{outline:1px solid rgba(242,234,211,.72);outline-offset:4px;border-radius:4px}.botanical{position:absolute;right:7%;bottom:7%;width:220px;height:220px;opacity:.13;z-index:-1}.botanical path{stroke:var(--ivory);stroke-linecap:round;stroke-linejoin:round}@keyframes enter{from{opacity:0;transform:translateY(12px) scale(.985)}to{opacity:1;transform:translateY(-18px) scale(1)}}@keyframes breathe{0%,100%{transform:scale(.98);opacity:.8}50%{transform:scale(1.04);opacity:1}}@media(max-width:520px){.page{padding:24px;overflow:visible}.logo-wrap{margin-bottom:12px}.title{font-size:clamp(2.25rem,13vw,3.4rem)}.lead{margin-bottom:32px}.opening{font-size:2rem}.botanical{display:none}.footer{font-size:.72rem;bottom:calc(34px + env(safe-area-inset-bottom))}}@media(orientation:landscape) and (max-height:560px){body{overflow-y:auto}.page{min-height:100dvh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:18px 24px calc(18px + env(safe-area-inset-bottom));overflow:visible}.card{transform:none;width:min(100%,720px)}.logo-wrap{width:clamp(74px,12vw,104px);height:clamp(74px,12vw,104px);margin-bottom:8px}.kicker{font-size:.62rem;margin-bottom:8px}.title{font-size:clamp(2rem,7vw,3rem);margin-bottom:12px}.lead{gap:3px;font-size:.9rem;margin-bottom:16px}.opening{font-size:clamp(1.15rem,4vw,1.55rem);padding:7px 22px 9px;border-radius:13px}.status{gap:7px}.substatus{font-size:.82rem}.footer{position:static;transform:none;margin-top:18px;font-size:.66rem}.botanical{display:none}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.card{transform:translateY(-18px)}}
</style>
</head>
<body>
<main class="page" aria-label="Midori Beauty coming soon">
  <div class="orb" aria-hidden="true"></div>
