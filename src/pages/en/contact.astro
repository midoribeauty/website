import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Contact · Midori Beauty | Private beauty studio in Tikkurila</title>
  <meta name="description" content="Book your private lash, nail or foot care appointment at Midori Beauty in Tikkurila, Vantaa." />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="stylesheet" href="/assets/styles/site.css" />
</head>
<body class="contact-page" data-reveal-selector=".page-header .label,.page-header .section-title,.page-header .lead,.section-head,.info-card,.why-art,.why .label,.why .section-title,.point,.contact-social-card,.intro-grid,.map-placeholder,.cta-box">
  <Navbar lang="en" current="contact" />
  <main>
    <section class="page-header"><div class="container"><div class="label">Contact</div><h1 class="section-title serif">Contact &amp; visit.</h1><p class="lead">Everything you need to plan your appointment at Midori Beauty — address, contact details, opening hours and booking links in one place.</p></div></section>
    <section class="practical"><div class="container"><div class="section-head"><div><div class="label">Plan your visit</div><h2 class="section-title serif">Clear details before you arrive.</h2></div><p class="lead">Booking is handled through Timma, while this page keeps the practical studio details easy to find.</p></div><div class="practical-grid"><article class="info-card"><h3 class="contact-card-title"><span class="social-icon"><img class="footer-icon" src="/assets/icons/location.svg" alt="" aria-hidden="true"></span>Address</h3><p>Neilikkatie 4C 43<br>Tikkurila, 01300 Vantaa<br>5th floor</p><p class="fit-note"><a class="mini-link" href="https://maps.google.com/?q=Neilikkatie%204C%2043,%2001300%20Vantaa" target="_blank" rel="noreferrer">Open in Google Maps →</a></p></article><article class="info-card hours-card"><h3 class="contact-card-title"><span class="social-icon"><img class="footer-icon" src="/assets/icons/booking.svg" alt="" aria-hidden="true"></span>Opening hours</h3><p>Mon–Fri: 09:00–19:00<br>Sat: 09:00–17:00<br>Sun &amp; public holidays: closed</p></article><article class="info-card"><h3 class="contact-card-title"><span class="social-icon"><img class="footer-icon" src="/assets/icons/phone.svg" alt="" aria-hidden="true"></span>Contact</h3><p><a class="mini-link" href="tel:+358408013412">0408013412</a><br><a class="mini-link" href="mailto:midoribeauty.fi@gmail.com">midoribeauty.fi@gmail.com</a><br><a class="mini-link" href="https://wa.me/358408013412" target="_blank" rel="noreferrer">WhatsApp →</a></p></article></div></div></section>
    <section class="why"><div class="container why-grid"><div class="why-art" aria-label="A calm Midori Beauty studio space"></div><div><div class="label">Before your visit</div><h2 class="section-title serif">A little preparation goes a long way.</h2><div class="points"><div class="point"><span class="n">01</span><div><strong>Please arrive on time</strong><span>Your appointment is reserved especially for you, so arriving on time helps keep the experience relaxed.</span></div></div><div class="point"><span class="n">02</span><div><strong>Need to change your booking?</strong><span>Please cancel or reschedule through Timma at least 24 hours in advance. For urgent changes, please call.</span></div></div><div class="point"><span class="n">03</span><div><strong>Questions before booking?</strong><span>Email or WhatsApp is best for general questions. For availability, Timma always has the latest calendar.</span></div></div></div></div></div></section>
    <section class="practical contact-social-section"><div class="container"><div class="section-head"><div><div class="label">Timma &amp; social</div><h2 class="section-title serif">Follow, view the profile, or book directly.</h2></div><p class="lead">Timma is the best place to check current services, availability and booking details.</p></div><div class="contact-social-grid"><article class="contact-social-card featured"><h3>Midori Beauty on Timma</h3><p>View the public Timma profile, check services and continue to direct online booking.</p><div class="contact-link-list"><a href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/timma.svg" alt="" aria-hidden="true"></span>Timma profile →</a><a href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/booking.svg" alt="" aria-hidden="true"></span>Book on Timma →</a></div></article><article class="contact-social-card"><h3>Follow us</h3><p>See updates, portfolio moments and studio news on social channels.</p><div class="contact-link-list"><a href="https://instagram.com/midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/instagram.svg" alt="" aria-hidden="true"></span>Instagram →</a><a href="https://www.tiktok.com/@midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/tiktok.svg" alt="" aria-hidden="true"></span>TikTok →</a><a href="https://www.facebook.com/midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/facebook.svg" alt="" aria-hidden="true"></span>Facebook →</a></div></article></div></div></section>
    <section class="practical"><div class="container intro-grid"><div><div class="label">Find us</div><h2 class="section-title serif">Easy to reach in central Tikkurila.</h2><p class="lead">Midori Beauty is located at Neilikkatie 4C 43 in Tikkurila, Vantaa. After booking, please check your confirmation and arrive at the reserved time.</p><p class="fit-note"><strong>Email:</strong> <a class="mini-link" href="mailto:midoribeauty.fi@gmail.com">midoribeauty.fi@gmail.com</a><br><strong>Phone:</strong> <a class="mini-link" href="tel:+358408013412">0408013412</a></p></div><div class="map-placeholder"><iframe title="Neilikkatie 4C 43, Vantaa map" src="https://www.google.com/maps?q=Neilikkatie%204C%2043%2C%2001300%20Vantaa%2C%20Finland&output=embed" loading="lazy"></iframe></div></div></section>
    <section class="cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Ready for your private studio moment?</h2><p>Choose a service, find a suitable time and continue to the booking page.</p></div><div class="actions"><a class="btn primary" href="../booking/">Book now</a><a class="btn ghost" href="../prices/">View prices</a></div></div></div></section>
  </main>
  <Footer lang="en" />
  <button class="back-to-top" type="button" aria-label="Back to top">↑</button>
  <script src="/assets/scripts/site.js" defer></script>
</body>
</html>
