<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Midori Beauty · Home Studio | Eyelash extensions, nails & foot spa</title>
  <meta name="description" content="Midori Beauty is a private lash, nail and foot care home studio in Tikkurila, Vantaa." />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="stylesheet" href="/assets/styles/site.css" />
</head>
<body>
  <Navbar lang="en" current="home" />
  <main>
    <section class="hero"><div class="hero-pattern" aria-hidden="true"></div><svg class="botanical" viewBox="0 0 220 220" fill="none" aria-hidden="true"><path d="M112 186C106 133 109 90 128 43" stroke-width="1.1"/><path d="M126 76C146 58 169 54 184 65C171 87 150 98 126 94C126 88 126 82 126 76Z" stroke-width="1.1"/><path d="M116 112C96 94 72 90 56 103C70 125 93 135 117 130C117 124 116 118 116 112Z" stroke-width="1.1" opacity=".72"/></svg><div class="hero-content"><div class="eyebrow">Tikkurila · Vantaa</div><h1 class="serif">Soft beauty, <em>at your pace</em>.</h1><p>Midori Beauty is a private home studio for lashes, nails and foot care — calm, personal, and carefully finished, one client at a time.</p><div class="actions"><a class="btn primary" href="./booking/">Book now</a><a class="btn ghost" href="#services">Services</a></div><div class="chips"><span class="chip"><strong>Private studio</strong>One client at a time</span><span class="chip"><strong>Minimal & refined</strong>Soft, natural aesthetic</span><span class="chip"><strong>Easy booking</strong>Times and prices online</span></div></div></section>
    <section class="intro" id="about"><div class="container intro-grid"><div><div class="label">About</div><h2 class="section-title serif">A calmer alternative to the rushed salon visit.</h2><p class="lead">Midori Beauty blends a soft, minimal aesthetic with careful work and the comfort of a private home studio. Designed for clients who value calm, clarity and natural-looking results.</p><a class="mini-link" href="./about/">Read more about Midori →</a></div><aside class="intro-card"><p class="quote serif">“Calm. Soft luxury. Natural beauty.”</p><div class="values"><div class="value"><strong>Calm</strong><span>One client at a time, with full attention on every visit.</span></div><div class="value"><strong>Soft luxury</strong><span>A warm, minimal atmosphere — unhurried and comfortable.</span></div><div class="value"><strong>Details</strong><span>Careful finishing for results that feel effortless in everyday life.</span></div></div></aside></div></section>
    <section class="services" id="services"><div class="container"><div class="section-head"><div><div class="label">Services</div><h2 class="section-title serif">Three service lines, one calm aesthetic.</h2></div><p class="lead">Up-to-date services, prices and available times are always shown in Timma.</p></div><div class="service-grid"><article class="service"><div class="service-img" aria-hidden="true"></div><div class="service-body"><span class="service-icon-main"><svg viewBox="0 0 24 24"><path d="M4 14c3-5 6.5-7.5 8-7.5S17 9 20 14"/><path d="M7 14.5c1.2.8 2.8 1.3 5 1.3s3.8-.5 5-1.3"/><path d="M9 12l-1.5-2M12 11.2V8.5M15 12l1.5-2"/></svg></span><h3 class="serif">Lashes</h3><p>Soft, natural lash styles that lift and define the eyes without feeling heavy.</p><a class="mini-link" href="./services/">Learn more →</a></div></article><article class="service"><div class="service-img" aria-hidden="true"></div><div class="service-body"><span class="service-icon-main"><svg viewBox="0 0 24 24"><path d="M8 19c1.5-4 3-7 4-10 1 3 2.5 6 4 10"/><path d="M9.5 12.5h5"/><path d="M7 19h10"/></svg></span><h3 class="serif">Nails</h3><p>Clean, minimal nail services for a refined, everyday look.</p><a class="mini-link" href="./services/">Learn more →</a></div></article><article class="service"><div class="service-img" aria-hidden="true"></div><div class="service-body"><span class="service-icon-main"><svg viewBox="0 0 24 24"><path d="M5 15c2-4 5-6 7-6s5 2 7 6"/><path d="M8 15.5c.8 1.5 2.3 2.5 4 2.5s3.2-1 4-2.5"/><path d="M12 7v2"/></svg></span><h3 class="serif">Foot care</h3><p>Relaxing foot care for comfort, softness and a polished feel.</p><a class="mini-link" href="./services/">Learn more →</a></div></article></div></div></section>
    <section class="gallery-preview" id="gallery"><div class="container"><div class="label">Gallery</div><h2 class="section-title serif">A small glimpse into Midori’s style.</h2><p class="lead">A calm aesthetic across lashes, nails and foot care — and a quiet, comfortable studio moment.</p><div class="gallery-grid"><figure class="gallery-item"></figure><figure class="gallery-item"></figure><figure class="gallery-item"></figure><figure class="gallery-item"></figure><figure class="gallery-item"></figure></div><a class="mini-link" href="./gallery/">View more →</a></div></section>
    <section class="why" id="why"><div class="container why-grid"><div class="why-art" aria-hidden="true"></div><div><div class="label">Why Midori</div><h2 class="section-title serif">No rush. No crowded salon feeling. Just careful work.</h2><p class="lead">A quiet private studio for clients who want a softer, more personal beauty experience.</p><div class="points"><div class="point"><div class="n">01</div><div><strong>Private 1–1 setting</strong><span>One time slot, one client, full attention.</span></div></div><div class="point"><div class="n">02</div><div><strong>Minimal, natural-looking results</strong><span>Polished and effortless — easy to wear every day.</span></div></div><div class="point"><div class="n">03</div><div><strong>Book in Timma</strong><span>Services, prices and available times stay up to date.</span></div></div></div></div></div></section>
    <section class="reviews"><div class="container"><div class="label">Studio experience</div><h2 class="section-title serif">What the visit is designed to feel like.</h2><div class="review-grid"><article class="review"><p>“A calm, private appointment with space to slow down.”</p><small>Designed experience</small></article><article class="review"><p>“Soft, natural-looking results for everyday confidence.”</p><small>Designed experience</small></article><article class="review"><p>“Clear booking, careful work, and no crowded salon feeling.”</p><small>Designed experience</small></article></div></div></section>
    <section class="practical" id="contact"><div class="container"><div class="label">Contact</div><h2 class="section-title serif">Find us in Tikkurila, Vantaa.</h2><p class="lead">Quiet water, old rapids, and a five-minute walk from the station.<br>Midori Beauty is located in central Tikkurila, Vantaa — easy to reach, yet calm enough to feel like a small pause in your day. Once you book, you’ll receive an instant confirmation of your appointment.</p><div class="practical-grid"><article class="info-card"><h3 class="serif">Location</h3><p>Neilikkatie 4C 43<br>Tikkurila, 01300 Vantaa<br>5th floor</p><p class="fit-note"><a class="mini-link" href="https://maps.google.com/?q=Neilikkatie%204C%2043,%2001300%20Vantaa" target="_blank" rel="noreferrer">Open in Google Maps →</a></p></article><article class="info-card"><h3 class="serif">Opening hours</h3><p>Mon–Fri: 9:00–19:00<br>Sat: 9:00–17:00<br>Sun &amp; public holidays: closed</p></article></div><div class="map-placeholder"><iframe title="Map showing Neilikkatie 4C 43, Tikkurila, Vantaa" src="https://www.google.com/maps?q=Neilikkatie%204C%2043%2C%2001300%20Vantaa%2C%20Finland&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div></section>
    <section class="cta" id="booking"><div class="container"><div class="cta-box"><div><h2 class="serif">Ready for a calmer beauty moment?</h2><p>Book your private appointment easily online via Midori Beauty’s booking page.</p></div><div class="actions"><a class="btn primary" href="./booking/">Book now</a><a class="btn ghost" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Book on Timma</a></div></div></div></section>
  </main>
  <Footer lang="en" />
  <button class="back-to-top" type="button" aria-label="Back to top">↑</button>
  <script>const year=document.getElementById('year');if(year)year.textContent=new Date().getFullYear();const menuButton=document.querySelector('.mobile-menu');const mobilePanel=document.getElementById('mobilePanel');if(menuButton&&mobilePanel){const closeMenu=()=>{mobilePanel.classList.remove('is-open');menuButton.setAttribute('aria-expanded','false')};menuButton.addEventListener('click',(event)=>{event.stopPropagation();const open=mobilePanel.classList.toggle('is-open');menuButton.setAttribute('aria-expanded',open?'true':'false')});mobilePanel.addEventListener('click',(event)=>event.stopPropagation());mobilePanel.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));document.addEventListener('click',closeMenu);document.addEventListener('touchstart',(event)=>{if(!mobilePanel.contains(event.target)&&!menuButton.contains(event.target))closeMenu()},{passive:true});document.addEventListener('keydown',(event)=>{if(event.key==='Escape')closeMenu()});}const topButton=document.querySelector('.back-to-top');window.addEventListener('scroll',()=>{if(window.scrollY>700){topButton.classList.add('is-visible')}else{topButton.classList.remove('is-visible')}});topButton.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));const revealItems=document.querySelectorAll('.intro .intro-grid,.section-head,.service,.gallery-item,.why-art,.why .label,.why .section-title,.why .lead,.point,.reviews .label,.reviews .section-title,.review,.practical .label,.practical .section-title,.practical .lead,.info-card,.map-placeholder,.cta-box');revealItems.forEach((el,index)=>{el.classList.add('reveal');if(index%3===1)el.classList.add('reveal-delay-1');if(index%3===2)el.classList.add('reveal-delay-2')});if('IntersectionObserver'in window){const revealObserver=new IntersectionObserver((entries)=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target)}})},{threshold:.16,rootMargin:'0px 0px -40px 0px'});revealItems.forEach(el=>revealObserver.observe(el))}else{revealItems.forEach(el=>el.classList.add('is-visible'))}</script>
</body>
</html>
