---
// English Prices page — updated from Midori Beauty price guide 2026-08-21
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { seo } from '../../content/seo';

const revealSelector = '.price-section .label,.price-section .section-title,.price-section .lead,.price-note,.price-highlight,.price-card,.price-callout,.cta-box';
const meta = seo.en.prices;
---

<BaseLayout
  lang="en"
  title={meta.title}
  description={meta.description}
  path={meta.path}
  bodyClass="prices-page"
  revealSelector={revealSelector}
>
  <Navbar lang="en" current="prices" />
  <main>
    <section class="price-section" id="prices-top"><div class="container"><div class="label">Prices</div><h1 class="section-title serif">Prices to guide your choice.</h1><p class="lead">Prices are shown as a practical guide for choosing your service. Timma shows the booking flow, available appointment times and any final service details.</p><p class="price-note">The red price shows the estimated price after the 10% package discount when lashes, nails and foot spa are booked together.</p>
      <div class="price-highlight-grid"><div class="price-highlight"><div class="label">Package offer</div><strong>Book lashes, nails and foot spa together and receive 10% off the three-service package.</strong><p>The discounted price is shown as a guide for choosing your service. Final booking, availability and service details are confirmed in Timma.</p></div></div>
      <div class="price-grid">
        <div class="price-card lashes" id="lashes"><div class="price-card-img" aria-hidden="true"></div><h3>Lashes &amp; brows</h3><p class="fit-note">Eyelash extensions, refills, lash lift, brow services and tinting.</p><ul class="price-list"><li class="price-row"><span>Classic eyelash extensions</span><strong>55 € <em>49.50 €</em></strong></li><li class="price-row"><span>Classic lash refill</span><strong>50 € <em>45 €</em></strong></li><li class="price-row"><span>Soft mink-style lash extensions</span><strong>55 € <em>49.50 €</em></strong></li><li class="price-row"><span>Soft mink-style lash refill</span><strong>50 € <em>45 €</em></strong></li><li class="price-row"><span>Light wispy lash extensions</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Light wispy lash refill</span><strong>55 € <em>49.50 €</em></strong></li><li class="price-row"><span>Hybrid eyelash extensions</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Hybrid lash refill</span><strong>55 € <em>49.50 €</em></strong></li><li class="price-row"><span>Volume eyelash extensions</span><strong>65 € <em>58.50 €</em></strong></li><li class="price-row"><span>Volume lash refill</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Mega volume 8D eyelash extensions</span><strong>75 € <em>67.50 €</em></strong></li><li class="price-row"><span>Mega volume 8D lash refill</span><strong>65 € <em>58.50 €</em></strong></li><li class="price-row"><span>Wet look eyelash extensions</span><strong>65 € <em>58.50 €</em></strong></li><li class="price-row"><span>Wet look lash refill</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Wispy / Kim K eyelash extensions</span><strong>65 € <em>58.50 €</em></strong></li><li class="price-row"><span>Wispy / Kim K lash refill</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Brown lashes add-on</span><strong>+5 € <em>+4.50 €</em></strong></li><li class="price-row"><span>Ombre coloured lashes add-on</span><strong>+15 € <em>13.50 €</em></strong></li><li class="price-row"><span>Lash lift and tint</span><strong>55 € <em>49.50 €</em></strong></li><li class="price-row"><span>Brow lamination and tint</span><strong>45 € <em>40.50 €</em></strong></li><li class="price-row"><span>Brow tint</span><strong>15 € <em>13.50 €</em></strong></li><li class="price-row"><span>Lash tint</span><strong>15 € <em>13.50 €</em></strong></li><li class="price-row"><span>Lash and brow tint</span><strong>25 € <em>22.50 €</em></strong></li><li class="price-row"><span>Lash extension removal</span><strong>25 € <em>22.50 €</em></strong></li></ul></div>
        <div class="price-card nails" id="nails"><div class="price-card-img" aria-hidden="true"></div><h3>Nails &amp; hands</h3><p class="fit-note">Gel polish, builder gel, hand spa, nail art and removals.</p><ul class="price-list"><li class="price-row"><span>Gel polish</span><strong>30 € <em>27 €</em></strong></li><li class="price-row"><span>Gel polish refill</span><strong>35 € <em>31.50 €</em></strong></li><li class="price-row"><span>Builder gel overlay</span><strong>55 € <em>49.50 €</em></strong></li><li class="price-row"><span>Builder gel refill</span><strong>45 € <em>40.50 €</em></strong></li><li class="price-row"><span>Chrome</span><strong>+10 € <em>+9 €</em></strong></li><li class="price-row"><span>French nail art</span><strong>+10 € <em>+9 €</em></strong></li><li class="price-row"><span>Cat eye</span><strong>+5 € <em>+4.50 €</em></strong></li><li class="price-row"><span>Large rhinestones / nail charms</span><strong>1 € / pc <em>0.90 € / pc</em></strong></li><li class="price-row"><span>Small rhinestones / nail charms</span><strong>0.50 € / pc <em>0.45 € / pc</em></strong></li><li class="price-row"><span>3D flower nail art</span><strong>5 € / flower <em>4.50 € / flower</em></strong></li><li class="price-row"><span>Three-colour polish</span><strong>+5 € <em>+4.50 €</em></strong></li><li class="price-row"><span>Nail design for 10 nails</span><strong>25 € <em>22.50 €</em></strong></li><li class="price-row"><span>Nail design / nail</span><strong>3 € / nail <em>2.70 € / nail</em></strong></li><li class="price-row"><span>Hand spa treatment</span><strong>30 € <em>27 €</em></strong></li><li class="price-row"><span>Hand spa treatment + gel polish</span><strong>40 € <em>36 €</em></strong></li><li class="price-row"><span>Gel polish removal</span><strong>15 € <em>13.50 €</em></strong></li><li class="price-row"><span>Acrylic nail removal</span><strong>25 € <em>22.50 €</em></strong></li></ul></div>
        <div class="price-card foot-care" id="foot-care"><div class="price-card-img" aria-hidden="true"></div><h3>Foot care</h3><p class="fit-note">A calm foot spa treatment and toenail finishing options.</p><ul class="price-list"><li class="price-row"><span>Foot spa treatment</span><strong>50 € <em>45 €</em></strong></li><li class="price-row"><span>Foot spa treatment + toenail polish</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Toenail polish</span><strong>40 € <em>36 €</em></strong></li></ul></div>
      </div>
      <div class="price-callout"><h3>Good to know</h3><p>Prices are shown as a practical guide for choosing your service. Timma shows the booking flow, available appointment times and any final service details.</p><p>Package offer: when you book lashes, nails and a foot spa service together, you receive 10% off the three-service package.</p><p>Please cancel at least 24 hours in advance through Timma. For urgent cancellations, please call the studio directly.</p></div>
    </div></section>
    <section class="cta" id="prices-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Choose your service, then take your time.</h2><p>Reserve directly in Timma to see available appointments and complete your booking.</p></div><div class="actions"><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Book now</a><a class="btn ghost" href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer">View on Timma</a></div></div></div></section>
  </main>
  <Footer lang="en" />
  <style>
    .price-note{margin:10px 0 0;color:var(--muted);font-size:.94rem;max-width:44rem}.price-row strong{display:inline-flex;align-items:baseline;gap:8px;flex-wrap:wrap;justify-content:flex-end}.price-row strong em{color:#b85b4d;font-style:normal;font-weight:750;white-space:nowrap}
  </style>
</BaseLayout>
