---
// Approved English Prices page port from Notion: EN — Prices Page — index.html
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Prices · Midori Beauty | Lash, nail &amp; foot care in Tikkurila</title>
  <meta name="description" content="An overview of lash, nail and foot care services at Midori Beauty in Tikkurila, Vantaa. Exact prices and availability are shown instantly in the booking calendar." />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="stylesheet" href="/assets/styles/site.css" />
</head>
<body class="prices-page" data-reveal-selector=".price-section .label,.price-section .section-title,.price-section .lead,.price-highlight,.price-card,.price-callout,.cta-box">
  <Navbar lang="en" current="prices" />
  <main>
    <section class="price-section" id="prices-top"><div class="container"><div class="label">Prices</div><h1 class="section-title serif">Prices at a glance.</h1><p class="lead">A simple overview of current services and prices. Final availability, service details and booking are handled through Timma.</p>
      <div class="price-highlight-grid"><div class="price-highlight"><div class="label">Package offer</div><strong>Book lashes, nails and foot spa together and receive 10% off the three-service package.</strong><p>A simple way to plan a fuller beauty day in one private appointment.</p></div></div>
      <div class="price-grid">
        <div class="price-card lashes" id="lashes"><div class="price-card-img" aria-hidden="true"></div><h3>Lashes &amp; brows</h3><p class="fit-note">Soft, tailored finishes — from natural sets to fuller volume.</p><ul class="price-list"><li class="price-row"><span>Classic lashes</span><strong>55 €</strong></li><li class="price-row"><span>Classic refill</span><strong>50 €</strong></li><li class="price-row"><span>Light natural lashes</span><strong>55 €</strong></li><li class="price-row"><span>Small fan / hybrid lashes</span><strong>60 €</strong></li><li class="price-row"><span>Volume lashes</span><strong>65 €</strong></li><li class="price-row"><span>Mega volume 8D</span><strong>75 €</strong></li><li class="price-row"><span>Wet look lashes</span><strong>65 €</strong></li><li class="price-row"><span>Lash lift</span><strong>55 €</strong></li><li class="price-row"><span>Brow lamination &amp; shaping</span><strong>40 €</strong></li><li class="price-row"><span>Lash removal</span><strong>25 €</strong></li></ul></div>
        <div class="price-card nails" id="nails"><div class="price-card-img" aria-hidden="true"></div><h3>Nails</h3><p class="fit-note">Minimal, lasting colour and strength for hands and toes.</p><ul class="price-list"><li class="price-row"><span>Gel polish</span><strong>30 €</strong></li><li class="price-row"><span>Gel polish refill</span><strong>35 €</strong></li><li class="price-row"><span>Builder gel</span><strong>55 €</strong></li><li class="price-row"><span>Builder gel refill</span><strong>45 €</strong></li><li class="price-row"><span>Hand spa</span><strong>30 €</strong></li><li class="price-row"><span>Toe nail polish</span><strong>40 €</strong></li><li class="price-row"><span>Gel removal</span><strong>15 €</strong></li><li class="price-row"><span>Acrylic removal</span><strong>25 €</strong></li></ul></div>
        <div class="price-card foot-care" id="foot-care"><div class="price-card-img" aria-hidden="true"></div><h3>Foot care &amp; extras</h3><p class="fit-note">A restorative foot ritual, with optional finishing details.</p><ul class="price-list"><li class="price-row"><span>Foot spa</span><strong>50 €</strong></li><li class="price-row"><span>Foot spa + toe gel polish</span><strong>65 €</strong></li><li class="price-row"><span>Brown lashes add-on</span><strong>+5 €</strong></li><li class="price-row"><span>Ombre colour lashes add-on</span><strong>+10 €</strong></li><li class="price-row"><span>Lash or brow tint add-on</span><strong>+5 €</strong></li><li class="price-row"><span>Chrome / French nail art</span><strong>+10 €</strong></li><li class="price-row"><span>Cat eye nail art</span><strong>+5 €</strong></li><li class="price-row"><span>Gel polish with hand spa</span><strong>+15 €</strong></li></ul></div>
      </div>
      <div class="price-callout"><h3>Good to know</h3><p>Prices are shown as a practical guide for choosing your service. Timma shows the booking flow, available appointment times and any final service details.</p><p>Please cancel at least 24 hours in advance through Timma. For urgent cancellations, please call the studio directly.</p></div>
    </div></section>
    <section class="cta" id="prices-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Choose your service, then take your time.</h2><p>Reserve directly in Timma to see available appointments and complete your booking.</p></div><div class="actions"><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Book now</a><a class="btn ghost" href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer">View on Timma</a></div></div></div></section>
  </main>
  <Footer lang="en" />
  <button class="back-to-top" type="button" aria-label="Back to top">↑</button>
  <script src="/assets/scripts/site.js" defer></script>
</body>
</html>
