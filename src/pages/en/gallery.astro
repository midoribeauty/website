---
// Approved English Gallery page port from Notion: EN — Gallery Page — index.html
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Gallery · Midori Beauty | Lash, nail & foot care studio in Tikkurila</title>
  <meta name="description" content="A visual glimpse into Midori Beauty's private lash, nail and foot care studio in Tikkurila, Vantaa." />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="stylesheet" href="/assets/styles/site.css" />
</head>
<body class="gallery-page" data-reveal-selector=".page-header .label,.page-header .section-title,.page-header .lead,.gallery-carousel,.gallery-browse .section-head,.gallery-thumb-grid,.cta-box">
  <Navbar lang="en" current="gallery" />
  <main>
    <section class="page-header" id="gallery-top"><div class="container"><div class="label">Gallery</div><h1 class="section-title serif">Results, details, and quiet studio moments.</h1><p class="lead">A visual mood board for Midori Beauty — soft finishes, clean details, and the calm feeling of time reserved just for you.</p></div></section>
    <section class="gallery-full" id="gallery-grid"><div class="container"><div class="gallery-carousel"><button class="gallery-nav prev" type="button" aria-label="Previous">‹</button><div class="gallery-slider-track" id="galleryTrack" aria-live="polite"></div><button class="gallery-nav next" type="button" aria-label="Next">›</button></div></div></section>
    <section class="gallery-browse" id="gallery-browse"><div class="container"><div class="section-head"><div><div class="label">Browse all</div><h2 class="section-title serif">See the full gallery at a glance.</h2><p class="lead">Showing 20 photos at a time. Tap any image to open it larger.</p></div></div><div class="gallery-thumb-grid" id="galleryThumbGrid" aria-live="polite"></div><div class="gallery-pagination" id="galleryPagination" aria-label="Gallery pagination"><button class="gallery-page-btn" id="galleryPrevPage" type="button" aria-label="Previous page">‹</button><span class="gallery-page-status" id="galleryPageStatus">Page 1</span><button class="gallery-page-btn" id="galleryNextPage" type="button" aria-label="Next page">›</button></div></div></section>
    <section class="cta" id="gallery-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Like what you see?</h2><p>Book your private appointment and experience it in person.</p></div><div class="actions"><a class="btn primary" href="../booking/">Book now</a><a class="btn ghost" href="../services/">View services</a></div></div></div></section>
  </main>
  <div class="lightbox" id="lightbox"><button class="lightbox-close" type="button" aria-label="Close">✕</button><button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous image">‹</button><div class="lightbox-img" id="lightboxImg"></div><button class="lightbox-nav lightbox-next" type="button" aria-label="Next image">›</button></div>
  <Footer lang="en" />
  <button class="back-to-top" type="button" aria-label="Back to top">↑</button>
  <script src="/assets/scripts/site.js" defer></script>
  <script src="/assets/scripts/gallery.js" defer></script>
</body>
</html>
