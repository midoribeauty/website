---
// Approved Finnish Contact page port from Notion: FI — Contact Page — index.html
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const revealSelector = '.page-header .label,.page-header .section-title,.page-header .lead,.section-head,.info-card,.why-art,.why .label,.why .section-title,.point,.contact-social-card,.intro-grid,.map-placeholder,.cta-box';
---

<BaseLayout
  lang="fi"
  title="Yhteys · Midori Beauty | Yksityinen studio Tikkurilassa"
  description="Varaa yksityinen ripsi-, kynsi- tai jalkahoitoaikasi Midori Beautysta Tikkurilassa, Vantaalla."
  path="/fi/contact/"
  bodyClass="contact-page"
  revealSelector={revealSelector}
>
  <Navbar lang="fi" current="contact" />
  <main>
    <section class="page-header"><div class="container"><div class="label">Yhteys</div><h1 class="section-title serif">Yhteys &amp; saapuminen.</h1><p class="lead">Kaikki tarvittava käynnin suunnitteluun Midori Beautyssa — osoite, yhteystiedot, aukioloajat ja ajanvarauslinkit yhdessä paikassa.</p></div></section>
    <section class="practical"><div class="container"><div class="section-head"><div><div class="label">Suunnittele käyntisi</div><h2 class="section-title serif">Selkeät tiedot ennen saapumista.</h2></div><p class="lead">Ajanvaraus hoidetaan Timman kautta, ja tältä sivulta löydät studion käytännön tiedot helposti.</p></div><div class="practical-grid"><article class="info-card"><h3 class="contact-card-title"><span class="social-icon"><img class="footer-icon" src="/assets/icons/location.svg" alt="" aria-hidden="true"></span>Osoite</h3><p>Neilikkatie 4C 43<br>Tikkurila, 01300 Vantaa<br>5. kerros</p><p class="fit-note"><a class="mini-link" href="https://maps.google.com/?q=Neilikkatie%204C%2043,%2001300%20Vantaa" target="_blank" rel="noreferrer">Avaa Google Mapsissa →</a></p></article><article class="info-card hours-card"><h3 class="contact-card-title"><span class="social-icon"><img class="footer-icon" src="/assets/icons/booking.svg" alt="" aria-hidden="true"></span>Aukioloajat</h3><p>Ma–Pe: 09:00–19:00<br>La: 09:00–17:00<br>Su ja pyhäpäivät: suljettu</p></article><article class="info-card"><h3 class="contact-card-title"><span class="social-icon"><img class="footer-icon" src="/assets/icons/phone.svg" alt="" aria-hidden="true"></span>Yhteys</h3><p><a class="mini-link" href="tel:+358408013412">0408013412</a><br><a class="mini-link" href="mailto:midoribeauty.fi@gmail.com">midoribeauty.fi@gmail.com</a><br><a class="mini-link" href="https://wa.me/358408013412" target="_blank" rel="noreferrer">WhatsApp →</a></p></article></div></div></section>
    <section class="why"><div class="container why-grid"><div class="why-art" aria-label="Rauhallinen Midori Beauty -studiotila"></div><div><div class="label">Ennen käyntiä</div><h2 class="section-title serif">Pieni valmistautuminen tekee käynnistä sujuvan.</h2><div class="points"><div class="point"><span class="n">01</span><div><strong>Saavu ajoissa</strong><span>Aikasi on varattu juuri sinulle. Oikea-aikainen saapuminen auttaa pitämään kokemuksen rauhallisena.</span></div></div><div class="point"><span class="n">02</span><div><strong>Tarvitsetko muutoksen varaukseen?</strong><span>Peruuta tai siirrä aika Timman kautta vähintään 24 tuntia etukäteen. Kiireellisissä muutoksissa soita.</span></div></div><div class="point"><span class="n">03</span><div><strong>Kysymyksiä ennen varaamista?</strong><span>Sähköposti tai WhatsApp sopii yleisiin kysymyksiin. Vapaat ajat näkyvät aina ajantasaisesti Timmassa.</span></div></div></div></div></div></section>
    <section class="practical contact-social-section"><div class="container"><div class="section-head"><div><div class="label">Timma &amp; some</div><h2 class="section-title serif">Seuraa, katso profiili tai varaa suoraan.</h2></div><p class="lead">Timma on paras paikka tarkistaa ajantasaiset palvelut, vapaat ajat ja varaustiedot.</p></div><div class="contact-social-grid"><article class="contact-social-card featured"><h3>Midori Beauty Timmassa</h3><p>Katso julkinen Timma-profiili, palvelut ja jatka suoraan ajanvaraukseen.</p><div class="contact-link-list"><a href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/timma.svg" alt="" aria-hidden="true"></span>Timma-profiili →</a><a href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/booking.svg" alt="" aria-hidden="true"></span>Varaa Timmassa →</a></div></article><article class="contact-social-card"><h3>Seuraa meitä</h3><p>Näe päivityksiä, portfolion hetkiä ja studion uutisia somekanavissa.</p><div class="contact-link-list"><a href="https://instagram.com/midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/instagram.svg" alt="" aria-hidden="true"></span>Instagram →</a><a href="https://www.tiktok.com/@midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/tiktok.svg" alt="" aria-hidden="true"></span>TikTok →</a><a href="https://www.facebook.com/midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/facebook.svg" alt="" aria-hidden="true"></span>Facebook →</a></div></article></div></div></section>
    <section class="practical"><div class="container intro-grid"><div><div class="label">Löydä meidät</div><h2 class="section-title serif">Helppo saapua keskeiseen Tikkurilaan.</h2><p class="lead">Midori Beauty sijaitsee osoitteessa Neilikkatie 4C 43, Tikkurila, Vantaa. Tarkista varausvahvistus ja saavuthan varattuun aikaan.</p><p class="fit-note"><strong>Sähköposti:</strong> <a class="mini-link" href="mailto:midoribeauty.fi@gmail.com">midoribeauty.fi@gmail.com</a><br><strong>Puhelin:</strong> <a class="mini-link" href="tel:+358408013412">0408013412</a></p></div><div class="map-placeholder"><iframe title="Neilikkatie 4C 43, Vantaa kartta" src="https://www.google.com/maps?q=Neilikkatie%204C%2043%2C%2001300%20Vantaa%2C%20Finland&output=embed" loading="lazy"></iframe></div></div></section>
    <section class="cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Valmis omaan rauhalliseen studiohetkeesi?</h2><p>Valitse palvelu, etsi sopiva aika ja jatka varaussivulle.</p></div><div class="actions"><a class="btn primary" href="../booking/">Varaa aika</a><a class="btn ghost" href="../prices/">Katso hinnat</a></div></div></div></section>
  </main>
  <Footer lang="fi" />
</BaseLayout>
