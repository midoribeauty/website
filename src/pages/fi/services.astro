---
// Approved Finnish Services page port from Notion: FI — Services Page — index.html
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="fi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Palvelut · Midori Beauty | Ripset, kynnet ja jalkojenhoito Tikkurilassa</title>
  <meta name="description" content="Tutustu Midori Beautyn ripsi-, kynsi- ja jalkojenhoitopalveluihin — yksityinen, rauhallinen kotistudio Tikkurilassa, Vantaalla. Hinnat ja vapaat ajat löytyvät Hinnat-sivulta." />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="stylesheet" href="/assets/styles/site.css" />
</head>
<body class="services-page">
  <Navbar lang="fi" current="services" />
  <main>
    <section class="page-header" id="services-top"><div class="container"><div class="label">Palvelut</div><h1 class="section-title serif">Valitse hoito, joka sopii päivääsi.</h1><p class="lead">Ripset, kynnet ja jalkojenhoito on koottu tänne selkeästi vertailtavaksi. Jokaisella palvelulla on oma rytminsä ja tarkoituksensa, ja hinnat sekä vapaat ajat pysyvät ajan tasalla Hinnat-sivulla.</p></div></section>
    <section class="service-block" id="lashes"><div class="container service-block-grid"><div class="service-photo lash" aria-hidden="true"></div><div class="service-block-content"><div class="label">Ripset</div><h2 class="section-title serif">Ilmeikkyyttä ilman painoa.</h2><p class="lead">Ripsien muotoilu tehdään oman silmänlinjasi, arkirutiinisi ja toivomasi lopputuloksen mukaan. Kaarevuus, pituus ja tiheys valitaan niin, että katse avautuu ilman raskasta tunnetta, ja lopputulos pysyy pehmeänä, tasapainoisena ja mukavana käyttää.</p><p class="fit-note"><strong>Sopii:</strong> ensikertalaisille, säännöllisille täydennysasiakkaille tai kevyeen sarjaan erityistilaisuuteen.</p><a class="mini-link" href="../prices/#lashes">Katso ripsien hinnat ja vaihtoehdot →</a></div></div></section>
    <section class="service-block bg-cream reverse" id="nails"><div class="container service-block-grid"><div class="service-photo nail" aria-hidden="true"></div><div class="service-block-content"><div class="label">Kynnet</div><h2 class="section-title serif">Selkeät linjat, hiljainen varmuus.</h2><p class="lead">Kynsipalveluissa keskitytään siistiin valmisteluun, tasapainoiseen muotoon ja arjessa toimivaan viimeistelyyn. Ilme voi olla minimalistinen tai viimeistellympi, mutta perusta on aina sama: huolellinen kynsinauhatyö, siisti rakenne ja terveeltä näyttävät kynnet.</p><p class="fit-note"><strong>Sopii:</strong> säännölliseen käsienhoitoon tai niille, jotka pitävät enemmän minimalistisesta, luonnollisesta kynsi-ilmeestä kuin näyttävästä kynsitaiteesta.</p><a class="mini-link" href="../prices/#nails">Katso kynsien hinnat ja vaihtoehdot →</a></div></div></section>
    <section class="service-block" id="foot-care"><div class="container service-block-grid"><div class="service-photo care" aria-hidden="true"></div><div class="service-block-content"><div class="label">Jalkojenhoito</div><h2 class="section-title serif">Rauhallinen hetki väsyneille jaloille.</h2><p class="lead">Jalkojenhoito on sekä mukavuutta että siistiä ulkonäköä varten: pehmeämpi iho, huolitellut kynnet ja kevyempi tunne käynnin jälkeen. Hoito on käytännöllinen, yksityiskohtainen ja erityisen hyödyllinen silloin, kun jalat kaipaavat enemmän kuin nopean lakkauksen.</p><p class="fit-note"><strong>Sopii:</strong> paljon jaloillaan olijoille tai kaikille, jotka kaipaavat rauhallisempaa hetkeä arkeen.</p><a class="mini-link" href="../prices/#foot-care">Katso jalkojenhoidon hinnat ja vaihtoehdot →</a></div></div></section>
    <section class="steps" id="how-it-works"><div class="container"><div class="label">Käynnin kulku</div><h2 class="section-title serif">Palvelun valinnasta viimeisteltyyn lopputulokseen.</h2><p class="lead">Selkeä kulku, jotta tiedät mitä tapahtuu ennen kuin varaat ajan.</p><div class="steps-grid"><div class="point"><div class="n">01</div><div><strong>Varaa Timmassa</strong><span>Valitse palvelu, näe hinta ja poimi sinulle sopiva aika.</span></div></div><div class="point"><div class="n">02</div><div><strong>Rauhallinen, yksityinen tila</strong><span>Saavut tilaan, jossa on vain sinä ja hoitaja — ei odotustilaa, ei kiirettä.</span></div></div><div class="point"><div class="n">03</div><div><strong>Lähde helpolla lopputuloksella</strong><span>Luonnollinen ja siisti tulos, jota on helppo ylläpitää seuraavaan käyntiin asti.</span></div></div></div></div></section>
    <section class="cta" id="services-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Kiinnostaako, mitä se maksaa?</h2><p>Jokaisella palvelulla on selkeä hinta ja saatavuus Hinnat-sivulla — ei tarvetta kysyä erikseen.</p></div><div class="actions"><a class="btn primary" href="../prices/">Katso hinnat</a><a class="btn ghost" href="../booking/">Varaa aika</a></div></div></div></section>
  </main>
  <Footer lang="fi" />
  <button class="back-to-top" type="button" aria-label="Takaisin alkuun">↑</button>
  <script>const year=document.getElementById('year');if(year)year.textContent=new Date().getFullYear();const menuButton=document.querySelector('.mobile-menu');const mobilePanel=document.getElementById('mobilePanel');if(menuButton&&mobilePanel){const closeMenu=()=>{mobilePanel.classList.remove('is-open');menuButton.setAttribute('aria-expanded','false')};menuButton.addEventListener('click',(event)=>{event.stopPropagation();const open=mobilePanel.classList.toggle('is-open');menuButton.setAttribute('aria-expanded',open?'true':'false')});mobilePanel.addEventListener('click',(event)=>event.stopPropagation());mobilePanel.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));document.addEventListener('click',closeMenu);document.addEventListener('touchstart',(event)=>{if(!mobilePanel.contains(event.target)&&!menuButton.contains(event.target))closeMenu()},{passive:true});document.addEventListener('keydown',(event)=>{if(event.key==='Escape')closeMenu()});}const topButton=document.querySelector('.back-to-top');window.addEventListener('scroll',()=>{if(window.scrollY>700){topButton.classList.add('is-visible')}else{topButton.classList.remove('is-visible')}});topButton.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));const revealItems=document.querySelectorAll('.page-header .label,.page-header .section-title,.page-header .lead,.service-photo,.service-block-content,.steps .label,.steps .section-title,.steps .lead,.point,.cta-box');revealItems.forEach((el,index)=>{el.classList.add('reveal');if(index%3===1)el.classList.add('reveal-delay-1');if(index%3===2)el.classList.add('reveal-delay-2')});if('IntersectionObserver'in window){const revealObserver=new IntersectionObserver((entries)=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target)}})},{threshold:.16,rootMargin:'0px 0px -40px 0px'});revealItems.forEach(el=>revealObserver.observe(el))}else{revealItems.forEach(el=>el.classList.add('is-visible'))}</script>
</body>
</html>
