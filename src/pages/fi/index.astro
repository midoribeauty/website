---
// Approved Finnish homepage port from Notion: FI — Main Homepage — index.html
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const revealSelector = '.intro .intro-grid,.section-head,.service,.gallery-item,.why-art,.why .label,.why .section-title,.why .lead,.point,.reviews .label,.reviews .section-title,.review,.practical .label,.practical .section-title,.practical .lead,.info-card,.map-placeholder,.cta-box';
---

<BaseLayout
  lang="fi"
  title="Midori Beauty · Kotistudio | Ripsienpidennykset, kynnet & jalkaspa"
  description="Midori Beauty on yksityinen ripsien, kynsien ja jalkojenhoidon kotistudio Tikkurilassa, Vantaalla."
  path="/fi/"
  revealSelector={revealSelector}
>
  <Navbar lang="fi" current="home" />
  <main>
    <section class="hero"><div class="hero-pattern" aria-hidden="true"></div><svg class="botanical" viewBox="0 0 220 220" fill="none" aria-hidden="true"><path d="M112 186C106 133 109 90 128 43" stroke-width="1.1"/><path d="M126 76C146 58 169 54 184 65C171 87 150 98 126 94C126 88 126 82 126 76Z" stroke-width="1.1"/><path d="M116 112C96 94 72 90 56 103C70 125 93 135 117 130C117 124 116 118 116 112Z" stroke-width="1.1" opacity=".72"/></svg><div class="hero-content"><div class="eyebrow">Tikkurila · Vantaa</div><h1 class="serif">Pehmeää kauneutta <em>rauhassa</em>.</h1><p>Midori Beauty on yksityinen ripsien, kynsien ja jalkojenhoidon kotistudio, jossa jokainen käynti tuntuu rauhalliselta, henkilökohtaiselta ja huolellisesti tehdyltä.</p><div class="actions"><a class="btn primary" href="./booking/">Varaa aika</a><a class="btn ghost" href="#services">Palvelut</a></div><div class="chips"><span class="chip"><strong>Private studio</strong>Yksi asiakas kerrallaan</span><span class="chip"><strong>Minimal & pehmeä</strong>Pehmeä ja luonnollinen estetiikka</span><span class="chip"><strong>Helppo ajanvaraus</strong>Ajat ja hinnat verkossa</span></div></div></section>
    <section class="intro" id="about"><div class="container intro-grid"><div><div class="label">Esittely</div><h2 class="section-title serif">Rauhallisempi vaihtoehto kiireiselle salonkikäynnille.</h2><p class="lead">Midori Beauty yhdistää pehmeän estetiikan, huolellisen työn ja yksityisen kotistudion tunnelman. Palvelu on suunniteltu asiakkaalle, joka arvostaa hiljaisuutta, selkeyttä ja luonnollista lopputulosta.</p><a class="mini-link" href="./about/">Lue lisää Midorista →</a></div><aside class="intro-card"><p class="quote serif">“Calm. Soft luxury. Natural beauty.”</p><div class="values"><div class="value"><strong>Rauha</strong><span>Yksi asiakas kerrallaan ja täysi huomio jokaiseen käyntiin.</span></div><div class="value"><strong>Pehmeä ylellisyys</strong><span>Tyylikäs, lämmin ja minimalistinen tunnelma ilman kiirettä.</span></div><div class="value"><strong>Yksityiskohdat</strong><span>Huolellinen työ luonnollisiin, arkeen sopiviin tuloksiin.</span></div></div></aside></div></section>
    <section class="services" id="services"><div class="container"><div class="section-head"><div><div class="label">Palvelut</div><h2 class="section-title serif">Kolme hoitolinjaa, yksi rauhallinen estetiikka.</h2></div><p class="lead">Ajantasaiset palvelut, hinnat ja vapaat ajat löytyvät Timmasta.</p></div><div class="service-grid"><article class="service"><div class="service-img" aria-hidden="true"></div><div class="service-body"><span class="service-icon-main"><svg viewBox="0 0 24 24"><path d="M4 14c3-5 6.5-7.5 8-7.5S17 9 20 14"/><path d="M7 14.5c1.2.8 2.8 1.3 5 1.3s3.8-.5 5-1.3"/><path d="M9 12l-1.5-2M12 11.2V8.5M15 12l1.5-2"/></svg></span><h3 class="serif">Ripset</h3><p>Pehmeät ja luonnolliset ripsityylit, jotka korostavat katsetta kevyesti.</p><a class="mini-link" href="./services/">Lue lisää →</a></div></article><article class="service"><div class="service-img" aria-hidden="true"></div><div class="service-body"><span class="service-icon-main"><svg viewBox="0 0 24 24"><path d="M8 19c1.5-4 3-7 4-10 1 3 2.5 6 4 10"/><path d="M9.5 12.5h5"/><path d="M7 19h10"/></svg></span><h3 class="serif">Kynnet</h3><p>Siistit ja minimalistiset kynsipalvelut eleganttiin arkeen.</p><a class="mini-link" href="./services/">Lue lisää →</a></div></article><article class="service"><div class="service-img" aria-hidden="true"></div><div class="service-body"><span class="service-icon-main"><svg viewBox="0 0 24 24"><path d="M5 15c2-4 5-6 7-6s5 2 7 6"/><path d="M8 15.5c.8 1.5 2.3 2.5 4 2.5s3.2-1 4-2.5"/><path d="M12 7v2"/></svg></span><h3 class="serif">Jalkojenhoito</h3><p>Rentouttavaa jalkojenhoitoa pehmeyteen, mukavuuteen ja viimeisteltyyn oloon.</p><a class="mini-link" href="./services/">Lue lisää →</a></div></article></div></div></section>
    <section class="gallery-preview" id="gallery"><div class="container"><div class="label">Galleria</div><h2 class="section-title serif">Pieni kurkistus Midorin tyyliin.</h2><p class="lead">Galleria näyttää Midori Beautyn pehmeän estetiikan: huolitellut ripset, minimalistiset kynnet, rentouttavat jalkahoidot ja rauhallisen studiohetken.</p><div class="gallery-grid"><figure class="gallery-item"></figure><figure class="gallery-item"></figure><figure class="gallery-item"></figure><figure class="gallery-item"></figure><figure class="gallery-item"></figure></div><a class="mini-link" href="./gallery/">Katso lisää →</a></div></section>
    <section class="why" id="why"><div class="container why-grid"><div class="why-art" aria-hidden="true"></div><div><div class="label">Miksi Midori</div><h2 class="section-title serif">Ei kiirettä. Ei massasalongin tunnetta. Vain huolellista hoitoa.</h2><p class="lead">Rauhallinen yksityinen studio asiakkaille, jotka toivovat pehmeämpää ja henkilökohtaisempaa kauneuskokemusta.</p><div class="points"><div class="point"><div class="n">01</div><div><strong>Yksityinen 1–1 ympäristö</strong><span>Yksi aika, yksi asiakas, täysi huomio.</span></div></div><div class="point"><div class="n">02</div><div><strong>Luonnollinen minimalistinen lopputulos</strong><span>Kauneutta, joka tuntuu viimeistellyltä mutta helpolta käyttää.</span></div></div><div class="point"><div class="n">03</div><div><strong>Ajanvaraus Timmassa</strong><span>Palvelut, hinnat ja vapaat ajat pysyvät helposti ajan tasalla.</span></div></div></div></div></div></section>
    <section class="reviews"><div class="container"><div class="label">Studiokokemus</div><h2 class="section-title serif">Miltä käynnin on tarkoitus tuntua.</h2><div class="review-grid"><article class="review"><p>“Rauhallinen yksityinen aika, jossa on tilaa hidastaa.”</p><small>Suunniteltu kokemus</small></article><article class="review"><p>“Pehmeä ja luonnollinen lopputulos arjen itsevarmuuteen.”</p><small>Suunniteltu kokemus</small></article><article class="review"><p>“Selkeä ajanvaraus, huolellinen työ ja ei massasalongin tunnetta.”</p><small>Suunniteltu kokemus</small></article></div></div></section>
    <section class="practical" id="contact"><div class="container"><div class="label">Yhteys</div><h2 class="section-title serif">Löydät meidät Tikkurilasta, Vantaalta.</h2><p class="lead">Rauhallista vettä, vanhat kosket ja viiden minuutin kävely asemalta.<br>Midori Beauty sijaitsee keskeisellä paikalla Tikkurilassa, Vantaalla — helposti saavutettavissa, mutta tarpeeksi rauhassa pientä hengähdyshetkeä varten. Kun varaat ajan, saat välittömän vahvistuksen ajastasi.</p><div class="practical-grid"><article class="info-card"><h3 class="serif">Osoite</h3><p>Neilikkatie 4C 43<br>Tikkurila, 01300 Vantaa<br>5. kerros</p><p class="fit-note"><a class="mini-link" href="https://maps.google.com/?q=Neilikkatie%204C%2043,%2001300%20Vantaa" target="_blank" rel="noreferrer">Avaa Google Mapsissa →</a></p></article><article class="info-card"><h3 class="serif">Aukioloajat</h3><p>Maanantai–perjantai: 9.00–19.00<br>Lauantai: 9.00–17.00<br>Sunnuntai ja pyhäpäivät: suljettu</p></article></div><div class="map-placeholder"><iframe title="Map showing Neilikkatie 4C 43, Tikkurila, Vantaa" src="https://www.google.com/maps?q=Neilikkatie%204C%2043%2C%2001300%20Vantaa%2C%20Finland&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div></section>
    <section class="cta" id="booking"><div class="container"><div class="cta-box"><div><h2 class="serif">Valmis rauhallisempaan kauneushetkeen?</h2><p>Varaa yksityinen aikasi helposti verkossa Midori Beautyn ajanvaraussivulla.</p></div><div class="actions"><a class="btn primary" href="./booking/">Varaa aika</a><a class="btn ghost" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Varaa Timmassa</a></div></div></div></section>
  </main>
  <Footer lang="fi" />
</BaseLayout>
