---
// Approved Finnish Booking page port from Notion: FI — Booking Page — index.html
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const revealSelector = '.page-header .label,.page-header .section-title,.page-header .lead,.booking-hero-card,.booking-card,.booking-practical article,.booking-final';
---

<BaseLayout
  lang="fi"
  title="Varaa aika · Midori Beauty"
  description="Varaa Midori Beauty -aikasi verkossa Timman kautta."
  path="/fi/booking/"
  bodyClass="booking-page"
  revealSelector={revealSelector}
>
  <Navbar lang="fi" current="booking" />
  <main><section class="page-header"><div class="container"><div class="label">Ajanvaraus</div><h1 class="section-title serif">Aikasi alkaa pienellä huolenpidolla.</h1><p class="lead">Muutama hyödyllinen vinkki ennen kuin varaat ajan Midori Beautylle Timmassa.</p></div></section><section class="booking-landing"><div class="container"><div class="booking-hero-card"><div><div class="label">Verkkoajanvaraus</div><h2 class="serif">Valmiina, kun sinä olet.</h2><p>Valitse palvelu, päivä ja sinulle sopiva aika Midori Beautyn turvallisesta Timma-ajanvarauskalenterista.</p></div><div class="booking-actions"><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer"><img src="/assets/icons/booking.svg" alt="" aria-hidden="true">Varaa aika Timmassa ↗</a><a class="text-link" href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer">Katso Timma-profiili</a><a class="text-link" href="../prices/">Katso palvelut ja hinnat</a></div></div><div class="booking-grid"><article class="booking-card"><div class="label">Näin varaat</div><h2 class="serif">Kolme helppoa vaihetta.</h2><ol class="booking-steps"><li><span>01</span><div><strong>Valitse palvelu</strong><p>Valitse käynnillesi sopivin hoito.</p></div></li><li><span>02</span><div><strong>Etsi sopiva aika</strong><p>Valitse päivä ja kellonaika, joka sopii sinulle.</p></div></li><li><span>03</span><div><strong>Vahvista Timmassa</strong><p>Täytä tietosi suoraan ajanvarauskalenterissa.</p></div></li></ol></article><article class="booking-card booking-note"><div class="label">Ensikäynti tai huolto?</div><h2 class="serif">Valitse oikea aika.</h2><p>Valitse ensikäynnille uusi setti tai hoito. Huoltoa varten valitse vastaava huoltopalvelu ja varmista, että jäljellä on riittävästi olemassa olevia ripsiä tai geeliä.</p><p>Jos et ole varma, varaatko huollon, poiston vai uuden setin, tarkista ensin hinnasto tai ota yhteyttä ennen varaamista.</p><div class="booking-links"><a class="text-link" href="../prices/">Katso hinnat</a><a class="text-link" href="../contact/">Ota yhteyttä</a></div></article></div><div class="booking-practical"><article><div class="label">Ennen käyntiä</div><h3 class="serif">Rauhallinen ja huolellinen käynti.</h3><p>Saavuthan sovittuun aikaan. Midori Beauty on yksityinen kotistudio Tikkurilassa, Vantaalla.</p><a class="text-link" href="../contact/">Sijainti ja aukioloajat</a></article><article><div class="label">Muutokset ja peruutukset</div><h3 class="serif">Ilmoita vähintään 24 tuntia aiemmin.</h3><p>Alle 24 tuntia ennen muutetusta tai perutusta ajasta voidaan veloittaa ajanvarausehtojen mukaisesti.</p><a class="text-link" href="../prices/">Katso varausehdot</a></article></div><div class="booking-final"><div><div class="label">Oma hetkesi</div><h2 class="serif">Löydetään sinulle sopiva aika.</h2><p>Timma avaa koko ajanvarauskalenterin ja ajantasaiset vapaat ajat.</p></div><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer"><img src="/assets/icons/booking.svg" alt="" aria-hidden="true">Varaa aika Timmassa ↗</a></div></div></section></main>
  <Footer lang="fi" />
</BaseLayout>
