---
// Approved Finnish Prices page port from Notion: FI — Prices Page — index.html
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { seo } from '../../content/seo';

const revealSelector = '.price-section .label,.price-section .section-title,.price-section .lead,.price-highlight,.price-card,.price-callout,.cta-box';
const meta = seo.fi.prices;
---

<BaseLayout
  lang="fi"
  title={meta.title}
  description={meta.description}
  path={meta.path}
  bodyClass="prices-page"
  revealSelector={revealSelector}
>
  <Navbar lang="fi" current="prices" />
  <main>
    <section class="price-section" id="prices-top"><div class="container"><div class="label">Hinnat</div><h1 class="section-title serif">Hinnat yhdellä silmäyksellä.</h1><p class="lead">Selkeä yleiskatsaus nykyisiin palveluihin ja hintoihin. Vapaat ajat, palvelun tiedot ja varaus hoidetaan Timmassa.</p>
      <div class="price-highlight-grid"><div class="price-highlight"><div class="label">Pakettietu</div><strong>Varaa ripset, kynnet ja jalkaspa yhdessä ja saat kolmen palvelun paketista 10 % alennuksen.</strong><p>Helppo tapa suunnitella kokonaisempi kauneushetki yhdelle yksityiselle ajalle.</p></div></div>
      <div class="price-grid">
        <div class="price-card lashes" id="lashes"><div class="price-card-img" aria-hidden="true"></div><h3>Ripset &amp; kulmat</h3><p class="fit-note">Pehmeitä, yksilöllisiä viimeistelyjä luonnollisesta tuuheampaan tyyliin.</p><ul class="price-list"><li class="price-row"><span>Klassiset ripset</span><strong>55 €</strong></li><li class="price-row"><span>Klassisten ripsien huolto</span><strong>50 €</strong></li><li class="price-row"><span>Erityiskevyet luonnolliset ripset</span><strong>55 €</strong></li><li class="price-row"><span>Pienet viuhka- / hybridiripset</span><strong>60 €</strong></li><li class="price-row"><span>Volyymiripset</span><strong>65 €</strong></li><li class="price-row"><span>Megavolyymiripset 8D</span><strong>75 €</strong></li><li class="price-row"><span>Wet look -ripset</span><strong>65 €</strong></li><li class="price-row"><span>Ripsien kestotaivutus</span><strong>55 €</strong></li><li class="price-row"><span>Kulmien laminointi ja muotoilu</span><strong>40 €</strong></li><li class="price-row"><span>Ripsien poisto</span><strong>25 €</strong></li></ul></div>
        <div class="price-card nails" id="nails"><div class="price-card-img" aria-hidden="true"></div><h3>Kynnet</h3><p class="fit-note">Minimalistista väriä ja kestävää vahvistusta käsille ja varpaille.</p><ul class="price-list"><li class="price-row"><span>Geelilakkaus</span><strong>30 €</strong></li><li class="price-row"><span>Geelilakkauksen huolto</span><strong>35 €</strong></li><li class="price-row"><span>Builder-geeli</span><strong>55 €</strong></li><li class="price-row"><span>Builder-geelin huolto</span><strong>45 €</strong></li><li class="price-row"><span>Käsispa</span><strong>30 €</strong></li><li class="price-row"><span>Varpaankynsien lakkaus</span><strong>40 €</strong></li><li class="price-row"><span>Geelin poisto</span><strong>15 €</strong></li><li class="price-row"><span>Akryylin poisto</span><strong>25 €</strong></li></ul></div>
        <div class="price-card foot-care" id="foot-care"><div class="price-card-img" aria-hidden="true"></div><h3>Jalkaspa &amp; lisät</h3><p class="fit-note">Palauttava jalkahoitohetki viimeistelyvaihtoehdoilla.</p><ul class="price-list"><li class="price-row"><span>Jalkaspa</span><strong>50 €</strong></li><li class="price-row"><span>Jalkaspa + varpaankynsien geelilakkaus</span><strong>65 €</strong></li><li class="price-row"><span>Ruskeat ripset -lisä</span><strong>+5 €</strong></li><li class="price-row"><span>Ombre-väriripset -lisä</span><strong>+10 €</strong></li><li class="price-row"><span>Ripsien tai kulmien värjäys -lisä</span><strong>+5 €</strong></li><li class="price-row"><span>Chrome / ranskalainen koristelu</span><strong>+10 €</strong></li><li class="price-row"><span>Cat eye -koristelu</span><strong>+5 €</strong></li><li class="price-row"><span>Geelilakkaus käsispa-palveluun</span><strong>+15 €</strong></li></ul></div>
      </div>
      <div class="price-callout"><h3>Hyvä tietää</h3><p>Hinnat auttavat valitsemaan sopivan palvelun. Timmassa näet varauspolun, vapaat ajat ja mahdolliset viimeiset palvelutiedot.</p><p>Peruuta aika vähintään 24 tuntia etukäteen Timmassa. Kiireellisissä peruutuksissa soita suoraan studiolle.</p></div>
    </div></section>
    <section class="cta" id="prices-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Valitse palvelusi ja varaa oma hetkesi.</h2><p>Varaa suoraan Timmassa, jossa näet vapaat ajat ja viimeistelet varauksesi.</p></div><div class="actions"><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Varaa aika</a><a class="btn ghost" href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer">Katso Timmassa</a></div></div></div></section>
  </main>
  <Footer lang="fi" />
</BaseLayout>
