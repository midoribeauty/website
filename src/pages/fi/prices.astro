---
// Finnish Prices page — updated from official Midori Beauty price list 2026-08-21
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { seo } from '../../content/seo';

const revealSelector = '.price-section .label,.price-section .section-title,.price-section .lead,.price-highlight,.price-card,.price-callout,.cta-box';
const meta = seo.fi.prices;
---

<BaseLayout
  lang="fi"
  title={meta.title}
  description={meta.description}
  path={meta.path}
  bodyClass="prices-page"
  revealSelector={revealSelector}
>
  <Navbar lang="fi" current="prices" />
  <main>
    <section class="price-section" id="prices-top"><div class="container"><div class="label">Hinnat</div><h1 class="section-title serif">Virallinen hinnasto.</h1><p class="lead">Ajantasainen yleiskatsaus Midori Beautyn ripsi-, kulma-, kynsi-, käsi- ja jalkahoitopalveluihin. Lopullinen varaus ja vapaat ajat hoidetaan Timmassa.</p>
      <div class="price-highlight-grid"><div class="price-highlight"><div class="label">Pakettietu</div><strong>Varaa ripset, kynnet ja jalkaspa yhdessä ja saat kolmen palvelun paketista 10 % alennuksen.</strong><p>Alennettu hinta näkyy alla viitteellisenä. Jos varaat useamman palvelun, tarkista kokonaisuus Timmassa tai kysy studiolla.</p></div></div>
      <div class="price-grid">
        <div class="price-card lashes" id="lashes"><div class="price-card-img" aria-hidden="true"></div><h3>Ripset &amp; kulmat</h3><p class="fit-note">Ripsienpidennykset, huollot, lash lift, kulmapalvelut ja värjäykset.</p><ul class="price-list"><li class="price-row"><span>Classic-ripsienpidennys</span><strong>55 €</strong></li><li class="price-row"><span>Classic-ripsienpidennysten huolto</span><strong>50 €</strong></li><li class="price-row"><span>Kevyet minkkiripset</span><strong>55 €</strong></li><li class="price-row"><span>Kevyiden minkkiripsien huolto</span><strong>50 €</strong></li><li class="price-row"><span>Kevyet ripsitupsut</span><strong>60 €</strong></li><li class="price-row"><span>Kevyiden ripsitupsujen huolto</span><strong>55 €</strong></li><li class="price-row"><span>Hybrid-ripsienpidennys</span><strong>60 €</strong></li><li class="price-row"><span>Hybrid-ripsienpidennysten huolto</span><strong>55 €</strong></li><li class="price-row"><span>Volyymiripsienpidennys</span><strong>65 €</strong></li><li class="price-row"><span>Volyymiripsienpidennysten huolto</span><strong>60 €</strong></li><li class="price-row"><span>Mega volume 8D -ripsienpidennys</span><strong>75 €</strong></li><li class="price-row"><span>Mega volume 8D -ripsienpidennysten huolto</span><strong>65 €</strong></li><li class="price-row"><span>Wet look -ripsienpidennys</span><strong>65 €</strong></li><li class="price-row"><span>Wet look -ripsienpidennysten huolto</span><strong>60 €</strong></li><li class="price-row"><span>Wispy / Kim K -ripsienpidennys</span><strong>65 €</strong></li><li class="price-row"><span>Wispy / Kim K -ripsienpidennysten huolto</span><strong>60 €</strong></li><li class="price-row"><span>Ruskeat ripset -lisä</span><strong>+5 €</strong></li><li class="price-row"><span>Ombre-väriripset -lisä</span><strong>+15 €</strong></li><li class="price-row"><span>Ripsien kestotaivutus ja värjäys</span><strong>55 €</strong></li><li class="price-row"><span>Kulmien laminointi ja värjäys</span><strong>45 €</strong></li><li class="price-row"><span>Kulmien värjäys</span><strong>15 €</strong></li><li class="price-row"><span>Ripsien värjäys</span><strong>15 €</strong></li><li class="price-row"><span>Ripsien ja kulmien värjäys</span><strong>25 €</strong></li><li class="price-row"><span>Ripsienpidennysten poisto</span><strong>25 €</strong></li></ul></div>
        <div class="price-card nails" id="nails"><div class="price-card-img" aria-hidden="true"></div><h3>Kynnet &amp; kädet</h3><p class="fit-note">Geelilakkaus, builder-geeli, käsispa, koristelut ja poistot.</p><ul class="price-list"><li class="price-row"><span>Geelilakkaus</span><strong>30 €</strong></li><li class="price-row"><span>Geelilakkauksen huolto</span><strong>35 €</strong></li><li class="price-row"><span>Oman kynnen vahvistus builder-geelillä</span><strong>55 €</strong></li><li class="price-row"><span>Builder-geelin huolto</span><strong>45 €</strong></li><li class="price-row"><span>Chrome</span><strong>+10 €</strong></li><li class="price-row"><span>Ranskalainen lakkaus</span><strong>+10 €</strong></li><li class="price-row"><span>Cat eye</span><strong>+5 €</strong></li><li class="price-row"><span>Isot strassit / kynsikoristeet</span><strong>1 € / kpl</strong></li><li class="price-row"><span>Pienet strassit / kynsikoristeet</span><strong>0,50 € / kpl</strong></li><li class="price-row"><span>3D-kukkakoriste</span><strong>5 € / kukka</strong></li><li class="price-row"><span>Kolmen värin lakkaus</span><strong>+5 €</strong></li><li class="price-row"><span>Kynsidesign 10 kynnelle</span><strong>25 €</strong></li><li class="price-row"><span>Kynsidesign / kynsi</span><strong>3 € / kynsi</strong></li><li class="price-row"><span>Käsihoito spa</span><strong>30 €</strong></li><li class="price-row"><span>Käsihoito spa + geelilakkaus</span><strong>40 €</strong></li><li class="price-row"><span>Geelilakkauksen poisto</span><strong>15 €</strong></li><li class="price-row"><span>Akryylikynsien poisto</span><strong>25 €</strong></li></ul></div>
        <div class="price-card foot-care" id="foot-care"><div class="price-card-img" aria-hidden="true"></div><h3>Jalkahoito</h3><p class="fit-note">Rauhallinen jalkaspa ja varpaankynsien viimeistely.</p><ul class="price-list"><li class="price-row"><span>Jalkahoito spa</span><strong>50 €</strong></li><li class="price-row"><span>Jalkahoito spa + varpaankynsien lakkaus</span><strong>60 €</strong></li><li class="price-row"><span>Varpaankynsien lakkaus</span><strong>40 €</strong></li></ul></div>
      </div>
      <div class="price-callout"><h3>Hyvä tietää</h3><p>Comboetu: kun varaat samaan kokonaisuuteen ripset, kynnet ja jalkaspa-palvelun, saat kolmen palvelun paketista 10 % alennuksen.</p><p>Peruuta aika vähintään 24 tuntia etukäteen Timma-sovelluksessa. Kiireellisissä peruutuksissa soita suoraan studiolle.</p><p>Hinnat ovat Midori Beautyn virallinen hinnasto 21.08.2026 alkaen. Hinnat ovat noin 20–30 % alueen salonkihintoja matalammat, mutta tavoitteena on sama tai parempi laatu rauhallisessa yksityisessä kotistudiossa.</p></div>
    </div></section>
    <section class="cta" id="prices-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Valitse palvelusi ja varaa oma hetkesi.</h2><p>Varaa suoraan Timmassa, jossa näet vapaat ajat ja viimeistelet varauksesi.</p></div><div class="actions"><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Varaa aika</a><a class="btn ghost" href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer">Katso Timmassa</a></div></div></div></section>
  </main>
  <Footer lang="fi" />
</BaseLayout>
