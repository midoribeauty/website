---
// Finnish Prices page — updated from Midori Beauty price guide 2026-08-21
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { seo } from '../../content/seo';

const revealSelector = '.price-section .label,.price-section .section-title,.price-section .lead,.price-highlight,.price-card,.price-callout,.cta-box';
const meta = seo.fi.prices;
---

<BaseLayout
  lang="fi"
  title={meta.title}
  description={meta.description}
  path={meta.path}
  bodyClass="prices-page"
  revealSelector={revealSelector}
>
  <Navbar lang="fi" current="prices" />
  <main>
    <section class="price-section" id="prices-top"><div class="container"><div class="label">Hinnat</div><h1 class="section-title serif">Hinnat palvelun valintaan.</h1><p class="lead">Hinnat auttavat valitsemaan sopivan palvelun. Timmassa näet varauspolun, vapaat ajat ja mahdolliset viimeiset palvelutiedot.</p>
      <div class="price-highlight-grid"><div class="price-highlight"><div class="label">Opening offer</div><strong>Avajaisten kunniaksi saat 10 % alennuksen kaikista palveluista.</strong><p>Tarjous on voimassa 31.10.2026 asti.</p></div></div>
      <div class="price-grid">
        <div class="price-card lashes" id="lashes"><div class="price-card-img" aria-hidden="true"></div><h3>Ripset &amp; kulmat</h3><p class="fit-note">Ripsienpidennykset, huollot, lash lift, kulmapalvelut ja värjäykset.</p><ul class="price-list"><li class="price-row"><span>Classic-ripsienpidennys</span><strong><s>55 €</s> <em>49,50 €</em></strong></li><li class="price-row"><span>Classic-ripsienpidennysten huolto</span><strong><s>50 €</s> <em>45 €</em></strong></li><li class="price-row"><span>Kevyet minkkiripset</span><strong><s>55 €</s> <em>49,50 €</em></strong></li><li class="price-row"><span>Kevyiden minkkiripsien huolto</span><strong><s>50 €</s> <em>45 €</em></strong></li><li class="price-row"><span>Kevyet ripsitupsut</span><strong><s>60 €</s> <em>54 €</em></strong></li><li class="price-row"><span>Kevyiden ripsitupsujen huolto</span><strong><s>55 €</s> <em>49,50 €</em></strong></li><li class="price-row"><span>Hybrid-ripsienpidennys</span><strong><s>60 €</s> <em>54 €</em></strong></li><li class="price-row"><span>Hybrid-ripsienpidennysten huolto</span><strong><s>55 €</s> <em>49,50 €</em></strong></li><li class="price-row"><span>Volyymiripsienpidennys</span><strong><s>65 €</s> <em>58,50 €</em></strong></li><li class="price-row"><span>Volyymiripsienpidennysten huolto</span><strong><s>60 €</s> <em>54 €</em></strong></li><li class="price-row"><span>Mega volume 8D -ripsienpidennys</span><strong><s>75 €</s> <em>67,50 €</em></strong></li><li class="price-row"><span>Mega volume 8D -ripsienpidennysten huolto</span><strong><s>65 €</s> <em>58,50 €</em></strong></li><li class="price-row"><span>Wet look -ripsienpidennys</span><strong><s>65 €</s> <em>58,50 €</em></strong></li><li class="price-row"><span>Wet look -ripsienpidennysten huolto</span><strong><s>60 €</s> <em>54 €</em></strong></li><li class="price-row"><span>Wispy / Kim K -ripsienpidennys</span><strong><s>65 €</s> <em>58,50 €</em></strong></li><li class="price-row"><span>Wispy / Kim K -ripsienpidennysten huolto</span><strong><s>60 €</s> <em>54 €</em></strong></li><li class="price-row"><span>Ruskeat ripset -lisä</span><strong><s>+5 €</s> <em>+4,50 €</em></strong></li><li class="price-row"><span>Ombre-väriripset -lisä</span><strong><s>+15 €</s> <em>13,50 €</em></strong></li><li class="price-row"><span>Ripsien kestotaivutus ja värjäys</span><strong><s>55 €</s> <em>49,50 €</em></strong></li><li class="price-row"><span>Kulmien laminointi ja värjäys</span><strong><s>45 €</s> <em>40,50 €</em></strong></li><li class="price-row"><span>Kulmien värjäys</span><strong><s>15 €</s> <em>13,50 €</em></strong></li><li class="price-row"><span>Ripsien värjäys</span><strong><s>15 €</s> <em>13,50 €</em></strong></li><li class="price-row"><span>Ripsien ja kulmien värjäys</span><strong><s>25 €</s> <em>22,50 €</em></strong></li><li class="price-row"><span>Ripsienpidennysten poisto</span><strong><s>25 €</s> <em>22,50 €</em></strong></li></ul></div>
        <div class="price-card nails" id="nails"><div class="price-card-img" aria-hidden="true"></div><h3>Kynnet &amp; kädet</h3><p class="fit-note">Geelilakkaus, builder-geeli, käsispa, koristelut ja poistot.</p><ul class="price-list"><li class="price-row"><span>Geelilakkaus</span><strong><s>30 €</s> <em>27 €</em></strong></li><li class="price-row"><span>Geelilakkauksen huolto</span><strong><s>35 €</s> <em>31,50 €</em></strong></li><li class="price-row"><span>Oman kynnen vahvistus builder-geelillä</span><strong><s>55 €</s> <em>49,50 €</em></strong></li><li class="price-row"><span>Builder-geelin huolto</span><strong><s>45 €</s> <em>40,50 €</em></strong></li><li class="price-row"><span>Chrome</span><strong><s>+10 €</s> <em>+9 €</em></strong></li><li class="price-row"><span>Ranskalainen lakkaus</span><strong><s>+10 €</s> <em>+9 €</em></strong></li><li class="price-row"><span>Cat eye</span><strong><s>+5 €</s> <em>+4,50 €</em></strong></li><li class="price-row"><span>Isot strassit / kynsikoristeet</span><strong><s>1 € / kpl</s> <em>0,90 € / kpl</em></strong></li><li class="price-row"><span>Pienet strassit / kynsikoristeet</span><strong><s>0,50 € / kpl</s> <em>0,45 € / kpl</em></strong></li><li class="price-row"><span>3D-kukkakoriste</span><strong><s>5 € / kukka</s> <em>4,50 € / kukka</em></strong></li><li class="price-row"><span>Kolmen värin lakkaus</span><strong><s>+5 €</s> <em>+4,50 €</em></strong></li><li class="price-row"><span>Kynsidesign 10 kynnelle</span><strong><s>25 €</s> <em>22,50 €</em></strong></li><li class="price-row"><span>Kynsidesign / kynsi</span><strong><s>3 € / kynsi</s> <em>2,70 € / kynsi</em></strong></li><li class="price-row"><span>Käsihoito spa</span><strong><s>30 €</s> <em>27 €</em></strong></li><li class="price-row"><span>Käsihoito spa + geelilakkaus</span><strong><s>40 €</s> <em>36 €</em></strong></li><li class="price-row"><span>Geelilakkauksen poisto</span><strong><s>15 €</s> <em>13,50 €</em></strong></li><li class="price-row"><span>Akryylikynsien poisto</span><strong><s>25 €</s> <em>22,50 €</em></strong></li></ul></div>
        <div class="price-card foot-care" id="foot-care"><div class="price-card-img" aria-hidden="true"></div><h3>Jalkahoito</h3><p class="fit-note">Rauhallinen jalkaspa ja varpaankynsien viimeistely.</p><ul class="price-list"><li class="price-row"><span>Jalkahoito spa</span><strong><s>50 €</s> <em>45 €</em></strong></li><li class="price-row"><span>Jalkahoito spa + varpaankynsien lakkaus</span><strong><s>60 €</s> <em>54 €</em></strong></li><li class="price-row"><span>Varpaankynsien lakkaus</span><strong><s>40 €</s> <em>36 €</em></strong></li></ul></div>
      </div>
      <div class="price-callout"><h3>Hyvä tietää</h3><p>Hinnat auttavat valitsemaan sopivan palvelun. Timmassa näet varauspolun, vapaat ajat ja mahdolliset viimeiset palvelutiedot.</p><p>Peruuta aika vähintään 24 tuntia etukäteen Timma-sovelluksessa. Kiireellisissä peruutuksissa soita suoraan studiolle.</p></div>
    </div></section>
    <section class="cta" id="prices-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Valitse palvelusi ja varaa oma hetkesi.</h2><p>Varaa suoraan Timmassa, jossa näet vapaat ajat ja viimeistelet varauksesi.</p></div><div class="actions"><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Varaa aika</a><a class="btn ghost" href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer">Katso Timmassa</a></div></div></div></section>
  </main>
  <Footer lang="fi" />
  <style>
    .price-row strong{display:inline-flex;align-items:baseline;gap:8px;flex-wrap:wrap;justify-content:flex-end}.price-row strong s{color:var(--muted);font-weight:650;text-decoration-thickness:1.5px;text-decoration-color:rgba(111,99,87,.68)}.price-row strong em{color:#b85b4d;font-style:normal;font-weight:750;white-space:nowrap}
  </style>
</BaseLayout>
