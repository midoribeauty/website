---
// Finnish Prices page — updated from Midori Beauty price guide 2026-08-21
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { seo } from '../../content/seo';

const revealSelector = '.price-section .label,.price-section .section-title,.price-section .lead,.opening-discount,.price-highlight,.price-card,.price-callout,.cta-box';
const meta = seo.fi.prices;
---

<BaseLayout
  lang="fi"
  title={meta.title}
  description={meta.description}
  path={meta.path}
  bodyClass="prices-page"
  revealSelector={revealSelector}
>
  <Navbar lang="fi" current="prices" />
  <main>
    <section class="price-section" id="prices-top"><div class="container"><div class="label">Hinnat</div><h1 class="section-title serif">Hinnat palvelun valintaan.</h1><p class="lead">Hinnat auttavat valitsemaan sopivan palvelun. Timmassa näet varauspolun, vapaat ajat ja mahdolliset viimeiset palvelutiedot.</p>
      <div class="price-highlight-grid"><div class="price-highlight"><div class="label">Pakettietu</div><strong>Varaa ripset, kynnet ja jalkaspa yhdessä ja saat kolmen palvelun paketista 10 % alennuksen.</strong><p>Lopullinen varaus, saatavuus ja palvelutiedot tarkistetaan Timmassa.</p></div></div>
      <div class="opening-discount"><strong>Avajaistarjous: punainen hinta on 10 % alennettu hinta.</strong></div>
      <div class="price-grid">
        <div class="price-card lashes" id="lashes"><div class="price-card-img" aria-hidden="true"></div><h3>Ripset &amp; kulmat</h3><p class="fit-note">Ripsienpidennykset, huollot, lash lift, kulmapalvelut ja värjäykset.</p><ul class="price-list"><li class="price-row"><span>Classic-ripsienpidennys</span><strong>55 € <em>49,50 €</em></strong></li><li class="price-row"><span>Classic-ripsienpidennysten huolto</span><strong>50 € <em>45 €</em></strong></li><li class="price-row"><span>Kevyet minkkiripset</span><strong>55 € <em>49,50 €</em></strong></li><li class="price-row"><span>Kevyiden minkkiripsien huolto</span><strong>50 € <em>45 €</em></strong></li><li class="price-row"><span>Kevyet ripsitupsut</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Kevyiden ripsitupsujen huolto</span><strong>55 € <em>49,50 €</em></strong></li><li class="price-row"><span>Hybrid-ripsienpidennys</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Hybrid-ripsienpidennysten huolto</span><strong>55 € <em>49,50 €</em></strong></li><li class="price-row"><span>Volyymiripsienpidennys</span><strong>65 € <em>58,50 €</em></strong></li><li class="price-row"><span>Volyymiripsienpidennysten huolto</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Mega volume 8D -ripsienpidennys</span><strong>75 € <em>67,50 €</em></strong></li><li class="price-row"><span>Mega volume 8D -ripsienpidennysten huolto</span><strong>65 € <em>58,50 €</em></strong></li><li class="price-row"><span>Wet look -ripsienpidennys</span><strong>65 € <em>58,50 €</em></strong></li><li class="price-row"><span>Wet look -ripsienpidennysten huolto</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Wispy / Kim K -ripsienpidennys</span><strong>65 € <em>58,50 €</em></strong></li><li class="price-row"><span>Wispy / Kim K -ripsienpidennysten huolto</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Ruskeat ripset -lisä</span><strong>+5 € <em>+4,50 €</em></strong></li><li class="price-row"><span>Ombre-väriripset -lisä</span><strong>+15 € <em>13,50 €</em></strong></li><li class="price-row"><span>Ripsien kestotaivutus ja värjäys</span><strong>55 € <em>49,50 €</em></strong></li><li class="price-row"><span>Kulmien laminointi ja värjäys</span><strong>45 € <em>40,50 €</em></strong></li><li class="price-row"><span>Kulmien värjäys</span><strong>15 € <em>13,50 €</em></strong></li><li class="price-row"><span>Ripsien värjäys</span><strong>15 € <em>13,50 €</em></strong></li><li class="price-row"><span>Ripsien ja kulmien värjäys</span><strong>25 € <em>22,50 €</em></strong></li><li class="price-row"><span>Ripsienpidennysten poisto</span><strong>25 € <em>22,50 €</em></strong></li></ul></div>
        <div class="price-card nails" id="nails"><div class="price-card-img" aria-hidden="true"></div><h3>Kynnet &amp; kädet</h3><p class="fit-note">Geelilakkaus, builder-geeli, käsispa, koristelut ja poistot.</p><ul class="price-list"><li class="price-row"><span>Geelilakkaus</span><strong>30 € <em>27 €</em></strong></li><li class="price-row"><span>Geelilakkauksen huolto</span><strong>35 € <em>31,50 €</em></strong></li><li class="price-row"><span>Oman kynnen vahvistus builder-geelillä</span><strong>55 € <em>49,50 €</em></strong></li><li class="price-row"><span>Builder-geelin huolto</span><strong>45 € <em>40,50 €</em></strong></li><li class="price-row"><span>Chrome</span><strong>+10 € <em>+9 €</em></strong></li><li class="price-row"><span>Ranskalainen lakkaus</span><strong>+10 € <em>+9 €</em></strong></li><li class="price-row"><span>Cat eye</span><strong>+5 € <em>+4,50 €</em></strong></li><li class="price-row"><span>Isot strassit / kynsikoristeet</span><strong>1 € / kpl <em>0,90 € / kpl</em></strong></li><li class="price-row"><span>Pienet strassit / kynsikoristeet</span><strong>0,50 € / kpl <em>0,45 € / kpl</em></strong></li><li class="price-row"><span>3D-kukkakoriste</span><strong>5 € / kukka <em>4,50 € / kukka</em></strong></li><li class="price-row"><span>Kolmen värin lakkaus</span><strong>+5 € <em>+4,50 €</em></strong></li><li class="price-row"><span>Kynsidesign 10 kynnelle</span><strong>25 € <em>22,50 €</em></strong></li><li class="price-row"><span>Kynsidesign / kynsi</span><strong>3 € / kynsi <em>2,70 € / kynsi</em></strong></li><li class="price-row"><span>Käsihoito spa</span><strong>30 € <em>27 €</em></strong></li><li class="price-row"><span>Käsihoito spa + geelilakkaus</span><strong>40 € <em>36 €</em></strong></li><li class="price-row"><span>Geelilakkauksen poisto</span><strong>15 € <em>13,50 €</em></strong></li><li class="price-row"><span>Akryylikynsien poisto</span><strong>25 € <em>22,50 €</em></strong></li></ul></div>
        <div class="price-card foot-care" id="foot-care"><div class="price-card-img" aria-hidden="true"></div><h3>Jalkahoito</h3><p class="fit-note">Rauhallinen jalkaspa ja varpaankynsien viimeistely.</p><ul class="price-list"><li class="price-row"><span>Jalkahoito spa</span><strong>50 € <em>45 €</em></strong></li><li class="price-row"><span>Jalkahoito spa + varpaankynsien lakkaus</span><strong>60 € <em>54 €</em></strong></li><li class="price-row"><span>Varpaankynsien lakkaus</span><strong>40 € <em>36 €</em></strong></li></ul></div>
      </div>
      <div class="price-callout"><h3>Hyvä tietää</h3><p>Hinnat auttavat valitsemaan sopivan palvelun. Timmassa näet varauspolun, vapaat ajat ja mahdolliset viimeiset palvelutiedot.</p><p>Comboetu: kun varaat samaan kokonaisuuteen ripset, kynnet ja jalkaspa-palvelun, saat kolmen palvelun paketista 10 % alennuksen.</p><p>Peruuta aika vähintään 24 tuntia etukäteen Timma-sovelluksessa. Kiireellisissä peruutuksissa soita suoraan studiolle.</p></div>
    </div></section>
    <section class="cta" id="prices-cta"><div class="container"><div class="cta-box"><div><h2 class="serif">Valitse palvelusi ja varaa oma hetkesi.</h2><p>Varaa suoraan Timmassa, jossa näet vapaat ajat ja viimeistelet varauksesi.</p></div><div class="actions"><a class="btn primary" href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer">Varaa aika</a><a class="btn ghost" href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer">Katso Timmassa</a></div></div></div></section>
  </main>
  <Footer lang="fi" />
  <style>
    .opening-discount{margin:18px 0 28px;padding:18px 22px;border:1px solid rgba(184,91,77,.26);border-radius:22px;background:rgba(184,91,77,.08);color:#b85b4d;box-shadow:var(--shadowSoft)}.opening-discount strong{display:block;font-size:1rem;line-height:1.45}.price-row strong{display:inline-flex;align-items:baseline;gap:8px;flex-wrap:wrap;justify-content:flex-end}.price-row strong em{color:#b85b4d;font-style:normal;font-weight:750;white-space:nowrap}
  </style>
</BaseLayout>
