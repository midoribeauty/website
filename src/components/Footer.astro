---
// Shared Footer component — Midori Beauty
// Extracted in refactor phase 2 from first-pass ported pages (05.08.2026).
//
// Usage:
//   <Footer lang="fi" />
//
// Props:
//   lang: 'fi' | 'en'
//
// Notes:
// - Markup/classes/ids preserved from original HTML, so the existing inline
//   year script on each page keeps working (<span id="year">).
// - Internal page links normalized to absolute paths (/fi/..., /en/...) —
//   same resolved URLs as the previous relative ./ and ../ links.

interface Props {
	lang: 'fi' | 'en';
}

const { lang } = Astro.props;

const pagePath = (page: 'home' | 'about' | 'services' | 'gallery' | 'prices' | 'contact') =>
	page === 'home' ? `/${lang}/` : `/${lang}/${page}/`;

const labels = {
	fi: {
		pagesTitle: 'Sivut',
		home: 'Etusivu',
		about: 'Esittely',
		services: 'Palvelut',
		gallery: 'Galleria',
		prices: 'Hinnat',
		contact: 'Yhteys',
		visitTitle: 'Sijainti & ajanvaraus',
		book: 'Varaa Timmassa',
		socialTitle: 'Some',
	},
	en: {
		pagesTitle: 'Pages',
		home: 'Home',
		about: 'About',
		services: 'Services',
		gallery: 'Gallery',
		prices: 'Prices',
		contact: 'Contact',
		visitTitle: 'Visit & book',
		book: 'Book on Timma',
		socialTitle: 'Social',
	},
} as const;

const t = labels[lang];
---

<footer id="footer">
	<div class="container footer-expanded">
		<div class="footer-brand">
			<img class="footer-logo" src="/assets/logo-wordmark.png" alt="Midori Beauty logo" />
			<div class="footer-service-line">Lashes, Nails &amp; Foot Care</div>
			<p><em>Private. No rush. No crowded salon. Just careful work.</em></p>
		</div>
		<div class="footer-col">
			<h4>{t.pagesTitle}</h4>
			<a href={pagePath('home')}>{t.home}</a>
			<a href={pagePath('about')}>{t.about}</a>
			<a href={pagePath('services')}>{t.services}</a>
			<a href={pagePath('gallery')}>{t.gallery}</a>
			<a href={pagePath('prices')}>{t.prices}</a>
			<a href={pagePath('contact')}>{t.contact}</a>
		</div>
		<div class="footer-col">
			<h4>{t.visitTitle}</h4>
			<a href="https://maps.google.com/?q=Neilikkatie%204C%2043,%2001300%20Vantaa" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/location.svg" alt="" aria-hidden="true" /></span>Neilikkatie 4C 43<br />01300 Vantaa</a>
			<a href="tel:+358408013412"><span class="social-icon"><img class="footer-icon" src="/assets/icons/phone.svg" alt="" aria-hidden="true" /></span>0408013412</a>
			<a href="mailto:midoribeauty.fi@gmail.com"><span class="social-icon"><img class="footer-icon" src="/assets/icons/email.svg" alt="" aria-hidden="true" /></span>midoribeauty.fi@gmail.com</a>
			<a href="https://varaa.timma.fi/midoribeauty" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/booking.svg" alt="" aria-hidden="true" /></span>{t.book}</a>
		</div>
		<div class="footer-col">
			<h4>{t.socialTitle}</h4>
			<a href="https://timma.fi/yritys/midori-beauty" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/timma.svg" alt="" aria-hidden="true" /></span>Timma</a>
			<a href="https://www.tiktok.com/@midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/tiktok.svg" alt="" aria-hidden="true" /></span>TikTok</a>
			<a href="https://www.facebook.com/midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/facebook.svg" alt="" aria-hidden="true" /></span>Facebook</a>
			<a href="https://instagram.com/midoribeauty.fi" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/instagram.svg" alt="" aria-hidden="true" /></span>Instagram</a>
			<a href="https://wa.me/358408013412" target="_blank" rel="noreferrer"><span class="social-icon"><img class="footer-icon" src="/assets/icons/whatsapp.svg" alt="" aria-hidden="true" /></span>WhatsApp</a>
		</div>
		<div class="footer-bottom">
			<span class="copyright">© <span id="year"></span> <a href="https://midoribeauty.fi" target="_blank" rel="noreferrer">Midori Beauty</a> · Designed by Augustine</span><a class="footer-site-link" href="https://midoribeauty.fi" target="_blank" rel="noreferrer">www.midoribeauty.fi</a>
		</div>
	</div>
</footer>
