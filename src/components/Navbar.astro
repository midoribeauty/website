---
// Shared Navbar component — Midori Beauty
// Extracted in refactor phase 1 from first-pass ported pages (05.08.2026).
//
// Usage:
//   <Navbar lang="fi" current="about" />
//
// Props:
//   lang:    'fi' | 'en'
//   current: 'home' | 'about' | 'services' | 'gallery' | 'prices' | 'contact' | 'booking'
//
// Notes:
// - Markup/classes/ids preserved from original HTML, so the existing inline
//   mobile-menu script on each page keeps working unchanged.
// - hrefs normalized to absolute paths (/fi/..., /en/...) — same resolved URLs
//   as the previous relative ./ and ../ links.
// - Language switch order normalized to FI/EN on all pages (the EN booking page
//   previously had it reversed).
// - aria-current="page" is set on the current page link (desktop nav), and on
//   the booking CTA for booking pages — matching the original behavior.

interface Props {
	lang: 'fi' | 'en';
	current: 'home' | 'about' | 'services' | 'gallery' | 'prices' | 'contact' | 'booking';
}

const { lang, current } = Astro.props;
const otherLang = lang === 'fi' ? 'en' : 'fi';

const pagePath = (l: 'fi' | 'en', page: Props['current']) =>
	page === 'home' ? `/${l}/` : `/${l}/${page}/`;

const labels = {
	fi: {
		home: 'Etusivu',
		about: 'Esittely',
		services: 'Palvelut',
		gallery: 'Galleria',
		prices: 'Hinnat',
		contact: 'Yhteys',
		book: 'Varaa aika',
		switchName: 'English',
	},
	en: {
		home: 'Home',
		about: 'About',
		services: 'Services',
		gallery: 'Gallery',
		prices: 'Prices',
		contact: 'Contact',
		book: 'Book now',
		switchName: 'Suomi',
	},
} as const;

const t = labels[lang];
const mainPages = ['home', 'about', 'services', 'gallery', 'prices', 'contact'] as const;
---

<header class="nav" id="top">
	<div class="container nav-inner">
		<a class="brand" href={pagePath(lang, 'home')} aria-label="Midori Beauty home">
			<img class="brand-mark" src="/assets/icon-circe.png" alt="Midori Beauty icon" />
			<span class="brand-name"><strong>Midori</strong><span>Beauty</span></span>
		</a>
		<nav class="nav-links" aria-label="Primary navigation">
			{
				mainPages.map((page) => (
					<a href={pagePath(lang, page)} aria-current={page === current && current !== 'home' ? 'page' : undefined}>
						{t[page]}
					</a>
				))
			}
			<span class="language-switch"><a href={pagePath('fi', current)}>FI</a><span>/</span><a href={pagePath('en', current)}>EN</a></span>
			<a class="nav-cta" href={pagePath(lang, 'booking')} aria-current={current === 'booking' ? 'page' : undefined}>{t.book}</a>
		</nav>
		<button class="mobile-menu" aria-label="Menu" aria-expanded="false">☰</button>
		<div class="mobile-panel" id="mobilePanel">
			{mainPages.map((page) => <a href={pagePath(lang, page)}>{t[page]}</a>)}
			<a href={pagePath(otherLang, current)}>{t.switchName}</a>
			<a class="nav-cta" href={pagePath(lang, 'booking')}>{t.book}</a>
		</div>
	</div>
</header>
